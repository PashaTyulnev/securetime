{% extends 'base.html.twig' %}

{% block title %}Mitarbeiterverwaltung{% endblock %}

{% block body %}

    <div data-controller="employee">

        <div data-employee-target="modalContainer"></div>

        {# ================= HEADER ================= #}
        <header class="relative z-10
                   -mx-6 px-6
                   backdrop-blur-xl bg-white/70 dark:bg-gray-900/70
                   border-b border-gray-200/50 dark:border-gray-800/50">

            <div class="px-6 py-4 flex items-center justify-between">
                <h1 class="text-3xl font-light tracking-tight
                       bg-gradient-to-r from-slate-900 to-slate-600
                       dark:from-white dark:to-gray-400
                       bg-clip-text text-transparent">
                    Mitarbeiterverwaltung
                </h1>

                <button
                    data-action="click->employee#openCreationModal"
                    class="app-button">
                    {{ ux_icon('lucide:user-plus', { class: 'w-5 h-5' }) }}
                    <span>Neuer Mitarbeiter</span>
                </button>
            </div>
        </header>

        {# ================= CONTENT ================= #}
        <div class="p-5">
            <turbo-frame id="employee-table" src="{{ path('all_employee_list_component') }}">
                <div class="py-12 flex justify-center">
                    <twig:Loader/>
                </div>
            </turbo-frame>
        </div>

    </div>

{% endblock %}
