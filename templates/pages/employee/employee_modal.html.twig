{% extends 'elements/modal.html.twig' %}

{% block content %}
    {% set definedEmployee = employee is defined ? employee : {} %}

    <div class="px-8 py-10">
        <div class="text-center mb-8 animate-bounce-in">
            <div
                class="mx-auto h-20 w-20 flex items-center justify-center rounded-3xl bg-gradient-to-br from-slate-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 shadow-inner">
                {{ ux_icon('lucide:user-plus', { class: 'h-11 w-11 text-slate-700 dark:text-gray-300' }) }}
            </div>
        </div>

        <h2 class="text-2xl font-light text-gray-900 dark:text-white mb-6 text-center">
            {{ 'navigation.employees'|trans }} {% if employee is defined %}{{ 'employee.edit'|trans }}{% else %}{{ 'employee.add'|trans }}{% endif %}
        </h2>

        {% include 'elements/modal_error.html.twig' with {'dataTargetName' : 'data-employee-target'} %}

        {% if employee is defined %}
            <form data-action="submit->employee#saveEdit" data-employee-uri-param="{{ definedEmployee['@id'] }}">
        {% else %}
            <form data-action="submit->employee#saveNew">
        {% endif %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">

                    {% include 'elements/input.html.twig' with {
                        'title': ('employee.first_name'|trans),
                        'type': 'text',
                        'systemName': 'firstName',
                        'placeholder': 'Alexander',
                        'required': 'required',
                        'devValue': definedEmployee.firstName|default(''),
                        'action': "data-action=input->employee#updateUsername",
                        'target': "data-employee-target=firstName"
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('employee.last_name'|trans),
                        'type': 'text',
                        'systemName': 'lastName',
                        'placeholder': 'Schmidt',
                        'required': 'required',
                        'devValue': definedEmployee.lastName|default(''),
                        'action': "data-action=input->employee#updateUsername",
                        'target': "data-employee-target=lastName"
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('common.birth_date'|trans),
                        'type': 'date',
                        'systemName': 'birthDate',
                        'placeholder': '25.06.1990',
                        'required': 'required',
                        'devValue': definedEmployee.birthDate is defined ? definedEmployee.birthDate|date('Y-m-d') : ''
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'classList': 'hidden',
                        'title': '',
                        'type': 'hidden',
                        'systemName': 'user[username]',
                        'placeholder': 'aschmidt',
                        'required': 'required',
                        'devValue': definedEmployee.user.username|default(''),
                        'target': "data-employee-target=userName"
                    } %}

                    {% include 'elements/select.html.twig' with {
                        'systemName': 'department',
                        'title': ('employee.department'|trans),
                        'options': departments | map(d => {
                            'value': d['@id'],
                            'label': d.title
                        }),
                        'defaultOption': ('employee.please_select'|trans),
                        'required': 'required',
                        'devValue': definedEmployee.department is defined and definedEmployee.department is not null
                        ? definedEmployee.department['@id']
                        : ''
                    } %}

                    {% if is_granted('ROLE_ADMIN') %}
                        {% include 'elements/select.html.twig' with {
                            'systemName': 'partnerCompany',
                            'title': ('employee.partner_company'|trans),
                            'options': partners | map(p => {
                                'value': p['@id'],
                                'label': p.title
                            }),
                            'defaultOption': 'DWSD',
                            'devValue': definedEmployee.partnerCompany is defined and definedEmployee.partnerCompany is not null
                            ? definedEmployee.partnerCompany['@id']
                            : ''
                        } %}
                    {% endif %}


                    {% include 'elements/multi_select.html.twig' with {
                        'systemName': 'roles',
                        'title': ('employee.roles'|trans),
                        'defaultOption': 'Rollen',
                        'options': roles | map(r => {
                            'value': r['@id'],
                            'label': r.displayName
                        }),
                        'required': 'required',
                        'devValue': (definedEmployee.user is defined and definedEmployee.user.roleEntities is defined and definedEmployee.user.roleEntities is iterable)
                            ? definedEmployee.user.roleEntities | map(r => r['@id'] is defined ? r['@id'] : r)
                            : []
                    } %}


                    {% include 'elements/select.html.twig' with {
                        'systemName': 'qualification',
                        'title': ('employee.qualification'|trans),
                        'options': qualifications | map(q => {
                            'value': q['@id'],
                            'label': q.title
                        }),
                        'defaultOption': ('employee.please_select'|trans),
                        'required': 'required',
                        'devValue': definedEmployee.qualification is defined and definedEmployee.qualification is not null
                        ? definedEmployee.qualification['@id']
                        : ''
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('employee.employee_number'|trans),
                        'type': 'text',
                        'systemName': 'number',
                        'placeholder': '123456',
                        'required': 'required',
                        'devValue': definedEmployee.number|default('')
                    } %}


                    {% include 'elements/input.html.twig' with {
                        'title': ('common.phone'|trans),
                        'type': 'text',
                        'systemName': 'phone',
                        'placeholder': '017685412456',
                        'required': 'required',
                        'devValue': definedEmployee.phone|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('common.email'|trans),
                        'type': 'email',
                        'systemName': 'user[email]',
                        'placeholder': 'max@gmail.com',
                        'required': 'required',
                        'devValue': definedEmployee.user.email|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('employee.guardian_id'|trans),
                        'type': 'text',
                        'systemName': 'guardianId',
                        'placeholder': '',
                        'devValue': definedEmployee.guardianId|default('')
                    } %}

                    {% include 'elements/select.html.twig' with {
                        'systemName': 'contracts[type]',
                        'title': ('employee.employment'|trans),
                        'options': [
                            {'value': 'geringfuegig', 'label': ('employment.minimal'|trans)},
                            {'value': 'teilzeit', 'label': ('employment.part_time'|trans)},
                            {'value': 'vollzeit', 'label': ('employment.full_time'|trans)}
                        ],
                        'defaultOption': ('employee.please_select'|trans),
                        'required': 'required',
                        'devValue': definedEmployee.contracts[0].type|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('employee.hours_per_month'|trans),
                        'type': 'number',
                        'systemName': 'contracts[maxMonthHours]',
                        'placeholder': '160',
                        'required': 'required',
                        'devValue': definedEmployee.contracts[0].maxMonthHours|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': '',
                        'type': 'hidden',
                        'systemName': 'user[id]',
                        'placeholder': '',
                        'devValue': definedEmployee.user.id|default('')
                    } %}

                    <input name="user[active]" type="hidden" value="true">
                </div>

                <div class="flex justify-end space-x-4">
                    <button type="button" data-action="click->modal#hide"
                            class="px-6 py-3.5 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200">
                        {{ 'common.cancel'|trans }}
                    </button>
                    <button type="submit"
                            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-slate-800 to-slate-900 dark:from-white dark:to-gray-100 text-white dark:text-gray-900 font-medium hover:shadow-lg transform hover:scale-[1.02] transition-all duration-200">
                        {{ 'common.save'|trans }}
                    </button>
                </div>
            </form>
    </div>
{% endblock %}
