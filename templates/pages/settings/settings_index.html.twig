{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.title'|trans }}{% endblock %}

{% block body %}
<div class="p-6">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">
            {{ 'settings.title'|trans }}
        </h1>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
            <form action="{{ path('app_settings_locale') }}" method="POST" class="space-y-6">
                <div>
                    <label for="locale" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        {{ 'settings.language'|trans }}
                    </label>
                    <select 
                        name="locale" 
                        id="locale"
                        class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg 
                               bg-white dark:bg-gray-700 text-gray-900 dark:text-white
                               focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        required
                    >
                        {% set currentLocale = currentLocale|default(app.request.locale|default('de')) %}
                        <option value="de" {% if currentLocale == 'de' %}selected{% endif %}>
                            {{ 'settings.language.german'|trans }}
                        </option>
                        <option value="ru" {% if currentLocale == 'ru' %}selected{% endif %}>
                            {{ 'settings.language.russian'|trans }}
                        </option>
                        <option value="ar" {% if currentLocale == 'ar' %}selected{% endif %}>
                            {{ 'settings.language.arabic'|trans }}
                        </option>
                    </select>
                    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                        {{ 'settings.language.select'|trans }}
                    </p>
                </div>

                <div class="flex justify-end">
                    <button 
                        type="submit"
                        class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg 
                               transition-colors duration-200 font-medium"
                    >
                        {{ 'settings.save'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
