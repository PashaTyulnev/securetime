{% extends 'base.html.twig' %}

{% block title %}Meine Abwesenheiten{% endblock %}

{% block body %}

{% set typeLabels = {
    'vacation':    'Urlaub',
    'sick':        'Krank',
    'unavailable': 'Nicht verfügbar'
} %}

<div>

    {# ================= HEADER ================= #}
    <header class="relative
               -mx-6 px-6
               backdrop-blur-xl bg-white/70 dark:bg-gray-900/70
               border-b border-gray-200/50 dark:border-gray-800/50">
        <div class="px-6 py-4">
            <h1 class="text-3xl font-light tracking-tight
                   bg-gradient-to-r from-slate-900 to-slate-600
                   dark:from-white dark:to-gray-400
                   bg-clip-text text-transparent">
                Meine Abwesenheiten
            </h1>
        </div>
    </header>

    <div class="p-5 space-y-6 max-w-4xl">

        {# ================= FLASH MESSAGES ================= #}
        {% for message in app.flashes('success') %}
            <div class="flex items-center space-x-3 px-5 py-4 rounded-2xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700/50 text-green-800 dark:text-green-300">
                {{ ux_icon('lucide:check-circle', { class: 'w-5 h-5 flex-shrink-0' }) }}
                <span class="text-sm font-medium">{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flex items-center space-x-3 px-5 py-4 rounded-2xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700/50 text-red-800 dark:text-red-300">
                {{ ux_icon('lucide:alert-circle', { class: 'w-5 h-5 flex-shrink-0' }) }}
                <span class="text-sm font-medium">{{ message }}</span>
            </div>
        {% endfor %}

        {# ================= KEIN EMPLOYEE-PROFIL ================= #}
        {% if noEmployee %}
            <div class="flex flex-col items-center py-16 space-y-3 text-gray-400 dark:text-gray-500">
                {{ ux_icon('lucide:user-x', { class: 'w-12 h-12' }) }}
                <p class="text-sm">Deinem Benutzerkonto ist kein Mitarbeiter-Profil zugeordnet.</p>
                <p class="text-xs">Bitte wende dich an einen Administrator.</p>
            </div>
        {% else %}

        {# ================= ANTRAGSFORMULAR ================= #}
        <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl">
            <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 flex items-center space-x-3">
                {{ ux_icon('lucide:calendar-plus', { class: 'w-5 h-5 text-slate-600 dark:text-gray-400' }) }}
                <h2 class="text-lg font-medium text-gray-900 dark:text-white">Neuen Antrag stellen</h2>
            </div>

            <form method="post" action="{{ path('app_my_absences_submit') }}" class="px-6 py-6">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                    {# Typ #}
                    <div class="sm:col-span-2">
                        <label for="type" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                            Typ <span class="text-red-500">*</span>
                        </label>
                        <select id="type" name="type" required
                                class="w-full bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-slate-500/50 dark:focus:ring-slate-400/50 transition-all duration-200">
                            <option value="" disabled selected>Bitte auswählen …</option>
                            <option value="vacation">Urlaub</option>
                            <option value="sick">Krank</option>
                            <option value="unavailable">Nicht verfügbar</option>
                        </select>
                    </div>

                    {# Startdatum #}
                    <div>
                        {% include 'elements/input.html.twig' with {
                            title: 'Startdatum',
                            type: 'date',
                            systemName: 'startDate',
                            required: 'required',
                            devValue: ''
                        } %}
                    </div>

                    {# Enddatum #}
                    <div>
                        {% include 'elements/input.html.twig' with {
                            title: 'Enddatum',
                            type: 'date',
                            systemName: 'endDate',
                            required: 'required',
                            devValue: ''
                        } %}
                    </div>

                    {# Grund #}
                    <div class="sm:col-span-2">
                        {% include 'elements/textarea.html.twig' with {
                            title: 'Grund (optional)',
                            systemName: 'reason',
                            rows: 3,
                            placeholder: 'z. B. geplante Reise, Arzttermin …',
                            devValue: ''
                        } %}
                    </div>

                </div>

                <div class="mt-6 flex justify-end">
                    <button type="submit" class="app-button">
                        {{ ux_icon('lucide:send', { class: 'w-5 h-5' }) }}
                        <span>Antrag einreichen</span>
                    </button>
                </div>

            </form>
        </div>

        {# ================= MEINE ANTRÄGE ================= #}
        <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 flex items-center space-x-3">
                {{ ux_icon('lucide:list', { class: 'w-5 h-5 text-slate-600 dark:text-gray-400' }) }}
                <h2 class="text-lg font-medium text-gray-900 dark:text-white">Meine Anträge</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50/80 dark:bg-gray-800/80">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Typ</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Zeitraum</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Grund</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Kommentar</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200/50 dark:divide-gray-700/50">

                    {% for absence in absences %}
                        {% set typeValue = absence.type.value %}
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors duration-200">

                            {# Typ #}
                            <td class="px-6 py-4">
                                {% if typeValue == 'vacation' %}
                                    <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
                                        {{ ux_icon('lucide:plane', { class: 'w-3.5 h-3.5' }) }}
                                        <span>Urlaub</span>
                                    </span>
                                {% elseif typeValue == 'sick' %}
                                    <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">
                                        {{ ux_icon('lucide:thermometer', { class: 'w-3.5 h-3.5' }) }}
                                        <span>Krank</span>
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                                        {{ ux_icon('lucide:ban', { class: 'w-3.5 h-3.5' }) }}
                                        <span>Nicht verfügbar</span>
                                    </span>
                                {% endif %}
                            </td>

                            {# Zeitraum #}
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                {{ absence.startDate|date('d.m.Y') }}
                                {% if absence.startDate != absence.endDate %}
                                    <span class="text-gray-400 mx-1">–</span>
                                    {{ absence.endDate|date('d.m.Y') }}
                                {% endif %}
                            </td>

                            {# Grund #}
                            <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400 max-w-xs">
                                {{ absence.reason ?: '—' }}
                            </td>

                            {# Status #}
                            <td class="px-6 py-4">
                                {% if absence.status.value == 'pending' %}
                                    <span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300">
                                        {{ ux_icon('lucide:clock', { class: 'w-3.5 h-3.5' }) }}
                                        <span>Ausstehend</span>
                                    </span>
                                {% elseif absence.status.value == 'approved' %}
                                    <span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300">
                                        {{ ux_icon('lucide:check-circle', { class: 'w-3.5 h-3.5' }) }}
                                        <span>Genehmigt</span>
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">
                                        {{ ux_icon('lucide:x-circle', { class: 'w-3.5 h-3.5' }) }}
                                        <span>Abgelehnt</span>
                                    </span>
                                {% endif %}
                            </td>

                            {# Admin-Kommentar #}
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 max-w-xs">
                                {{ absence.adminComment ?: '—' }}
                            </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-sm text-gray-400 dark:text-gray-500 italic">
                                Noch keine Anträge gestellt.
                            </td>
                        </tr>
                    {% endfor %}

                    </tbody>
                </table>
            </div>
        </div>

        {% endif %}{# end noEmployee #}

    </div>
</div>

{% endblock %}
