{% set presetsArray = shiftPresets.member is defined ? shiftPresets.member : shiftPresets %}
<div data-controller="facility-shift-behavior"
     data-facility-shift-behavior-shift-presets-value="{{ {'member': presetsArray}|json_encode|e('html_attr') }}"
     class="border border-gray-200/30 dark:border-gray-700/30 rounded-xl bg-white/50 dark:bg-gray-800/50 hover:bg-white/70 dark:hover:bg-gray-800/70 transition-all mb-2 overflow-visible">

    <form method="post" id="shift-form-{{ demandShift.id|default('new') }}"
          data-action="submit->facility-shift#submitShift">
        {% if demandShift.id|default(false) %}
            <input type="hidden" name="id" value="{{ demandShift.id }}">
            <input type="hidden" name="uri" value="{{ demandShift['@id'] }}">
        {% endif %}
        <input type="hidden" name="facility" value="{{ facility['@id'] }}">

        {# Hauptbereich mit Schicht-Informationen #}
        <div class="p-2 widescreen:p-3">
            <div class="grid grid-cols-6 widescreen:grid-cols-12 gap-2 widescreen:gap-3 items-start">

                {# Schichtname mit Farbe - 3 Spalten #}
                <div class="col-span-2 widescreen:col-span-3">
                    <label
                        class="text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1 block">
                        {{ 'facility_shift.shift'|trans }}
                    </label>
                    <div class="flex items-center gap-2">
                        {% set shiftName = demandShift.name|default('')|lower %}


                        <input
                            type="hidden"
                            name="color"
                            form="shift-form-{{ demandShift.id|default('new') }}"
                            data-facility-shift-behavior-target="colorInput"
                            data-action="change->facility-shift-behavior#changeColor {% if demandShift.id|default(false) %}change->facility-shift#update{% endif %}"
                            class="appearance-none w-7 h-7 rounded-lg border border-white/40 cursor-pointer hover:shadow-md hover:scale-[1.05] focus:outline-none focus:ring-2 focus:ring-white/60 focus:scale-[1.05] transition-all duration-150"
                            title="{{ 'facility_shift.select_color'|trans }}"
                            value="{{ demandShift.color|default('#3b82f6') }}"/>


                        <select name="name"
                                style="background-color: {{ demandShift.color|default('#3b82f6') }};"
                                form="shift-form-{{ demandShift.id|default('new') }}"
                                class="flex-1 min-w-0 bg-white dark:bg-gray-800 font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 rounded-lg px-3 py-2 text-sm"
                                required
                                data-action="change->facility-shift-behavior#shiftChanged {% if demandShift.id|default(false) %}change->facility-shift#update{% endif %}"
                                data-facility-shift-behavior-target="shiftSelect">
                            <option>{{ 'facility_shift.shift_select'|trans }}</option>
                            {% for preset in presetsArray %}
                                <option value="{{ preset.name }}"
                                        {% if shiftName == preset.name|lower %}selected{% endif %}>
                                    {{ preset.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                {# Qualifikation - 2 Spalten #}
                <div class="col-span-2 widescreen:col-span-2">
                    <label
                        class="text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1 block">
                        {{ 'facility_shift.qualification'|trans }}
                    </label>
                    <select name="requiredQualification"
                            data-action="{% if demandShift.id|default(false) %}change->facility-shift#update{% endif %}"
                            form="shift-form-{{ demandShift.id|default('new') }}"
                            data-facility-shift-behavior-target="qualificationSelect"
                            class="w-full bg-white dark:bg-gray-800 font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 rounded-lg px-3 py-2 text-sm"
                            required>
                        <option value="">{{ 'facility_shift.select'|trans }}</option>
                        {% for qualification in qualifications %}
                            <option value="{{ qualification['@id'] }}"
                                    {% if demandShift.requiredQualification.id|default('') == qualification.id %}selected{% endif %}>
                                {{ qualification.title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Zeit - 2 Spalten #}
                <div class="col-span-2 widescreen:col-span-2">
                    <label
                        class="text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1 block">
                        {{ 'common.time'|trans }}
                    </label>
                    <div class="flex items-center gap-1.5">
                        <input type="time" name="timeFrom"
                               form="shift-form-{{ demandShift.id|default('new') }}"
                               data-facility-shift-behavior-target="timeFrom"
                               data-action="{% if demandShift.id|default(false) %}change->facility-shift#update{% endif %}"
                               value="{% if demandShift.timeFrom|default(false) %}{{ demandShift.timeFrom|date('H:i') }}{% endif %}"
                               class="w-full bg-white dark:bg-gray-800 rounded-lg px-2 py-2 text-sm text-white"
                               required>
                        <span class="text-gray-400 text-xs shrink-0">-</span>
                        <input type="time" name="timeTo"
                               form="shift-form-{{ demandShift.id|default('new') }}"
                               data-action="{% if demandShift.id|default(false) %}change->facility-shift#update{% endif %}"
                               data-facility-shift-behavior-target="timeTo"
                               value="{% if demandShift.timeTo|default(false) %}{{ demandShift.timeTo|date('H:i') }}{% endif %}"
                               class="w-full bg-white dark:bg-gray-800 rounded-lg px-2 py-2 text-sm text-white"
                               required>
                    </div>
                </div>

                {# Personal - 1 Spalte #}
                <div class="col-span-1 widescreen:col-span-1">
                    <label
                        class="text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1 block">
                        {{ 'facility_shift.personnel'|trans }}
                    </label>
                    <input type="number" name="amountEmployees"
                           form="shift-form-{{ demandShift.id|default('new') }}"
                           value="{{ demandShift.amountEmployees|default(1) }}"
                           data-action="{% if demandShift.id|default(false) %}change->facility-shift#update{% endif %}"
                           min="1" max="10"
                           class="w-full bg-white dark:bg-gray-800 rounded-lg px-2 py-2 text-sm text-center text-white"
                           required>
                </div>

                {# Wochentage - 3 Spalten (mehr Platz!) #}
                <div class="col-span-4 widescreen:col-span-3">
                    <label
                        class="text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1 block">
                        {{ 'schedule.weekdays'|trans }}
                    </label>
                    <div class="flex gap-1 flex-wrap">
                        {% set days = {
                            'Monday': ('schedule.day.monday'|trans), 'Tuesday': ('schedule.day.tuesday'|trans), 'Wednesday': ('schedule.day.wednesday'|trans), 'Thursday': ('schedule.day.thursday'|trans),
                            'Friday': ('schedule.day.friday'|trans), 'Saturday': ('schedule.day.saturday'|trans), 'Sunday': ('schedule.day.sunday'|trans)
                        } %}
                        {% for key, label in days %}
                            <input type="checkbox" name="on{{ key }}" value="1"
                                   form="shift-form-{{ demandShift.id|default('new') }}"
                                   id="{{ key }}_{{ demandShift.id|default('new') }}"
                                   {% if attribute(demandShift, 'on' ~ key|capitalize)|default(false) %}checked{% endif %}
                                   class="hidden day-checkbox"
                                   data-action="change->facility-shift-behavior#toggleDay {% if demandShift.id|default(false) %}change->facility-shift#update{% endif %}"
                                   data-facility-shift-behavior-target="dayCheckbox">
                            <label for="{{ key }}_{{ demandShift.id|default('new') }}"
                                   class="{% if attribute(demandShift, 'on' ~ key|capitalize)|default(false) %}activeDay{% else %}inactiveDay{% endif %} cursor-pointer transition-all text-xs px-2 py-1 rounded">
                                {{ label }}
                            </label>
                        {% endfor %}
                    </div>
                </div>

                {# Aktionen - 1 Spalte #}
<div class="col-span-1 widescreen:col-span-1">
                    <label
                        class="text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1 block">
                        &nbsp;
                    </label>
                    <div class="flex items-center justify-end gap-1">
                        {% if demandShift.id|default(false) %}
                            <button type="button"
                                    data-action="facility-shift#delete"
                                    data-facility-shift-uri-param="{{ demandShift['@id'] }}"
                                    class="p-1.5 hover:bg-red-100 dark:hover:bg-red-900/30 rounded-lg transition-colors"
                                    title="{{ 'common.delete'|trans }}">
                                {{ ux_icon('lucide:trash-2', { class: 'h-4 w-4 text-gray-500 hover:text-red-600' }) }}
                            </button>
                        {% else %}
                            <button type="submit" form="shift-form-{{ demandShift.id|default('new') }}"
                                    class="p-1.5 hover:bg-blue-100 dark:hover:bg-blue-900/30 rounded-lg transition-colors"
                                    title="{{ 'common.save'|trans }}">
                                {{ ux_icon('lucide:save', { class: 'h-4 w-4 text-blue-600 hover:text-blue-700' }) }}
                            </button>
                            <button type="button"
                                    data-action="facility-shift-behavior#removeRow"
                                    class="p-1.5 hover:bg-red-100 dark:hover:bg-red-900/30 rounded-lg transition-colors remove-new-row"
                                    title="{{ 'common.cancel'|trans }}">
                                {{ ux_icon('lucide:x', { class: 'h-4 w-4 text-gray-500 hover:text-red-600' }) }}
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap">

        {% if facility.positions | length > 0 %}
            <div class="px-2 widescreen:px-3 pb-2 pt-1.5 border-t border-gray-200/30 dark:border-gray-700/30 w-1/2 widescreen:w-1/4">
                {% include 'elements/multi_select.html.twig' with {
                    'systemName': 'requiredPositions',
                    'title': ('facility_shift.required_positions'|trans),
                    'defaultOption': ('facility_shift.select_positions'|trans),
                    'options': facility.positions | map(p => {
                        'value': p['@id'],
                        'label': p.title
                    }),
                    'devValue': (demandShift.requiredPositions is defined and demandShift.requiredPositions is iterable)
                    ? demandShift.requiredPositions | map(p => p['@id'] is defined ? p['@id'] : p)
                    : [],
                    'formId': 'shift-form-' ~ (demandShift.id|default('new')),
                    'updateAction': demandShift.id|default(false) ? 'facility-shift#update' : null
                } %}
            </div>
        {% endif %}

        <div class="px-2 widescreen:px-3 pb-2 pt-1.5 border-t border-gray-200/30 dark:border-gray-700/30 w-1/2 widescreen:w-1/4">
            {% include 'elements/multi_select.html.twig' with {
                'systemName': 'partnerVisibility',
                'title': ('facility_shift.partner_visibility'|trans),
                'defaultOption': ('facility_shift.select_partners'|trans),
                'options': partners | map(p => {
                    'value': p['@id'],
                    'label': p.title
                }),
                'devValue': (demandShift.partnerVisibility is defined and demandShift.partnerVisibility is iterable)
                ? demandShift.partnerVisibility | map(p => p['@id'] is defined ? p['@id'] : p)
                : [],
                'formId': 'shift-form-' ~ (demandShift.id|default('new')),
                'updateAction': demandShift.id|default(false) ? 'facility-shift#update' : null
            } %}
        </div>

        </div>

    </form>
</div>
