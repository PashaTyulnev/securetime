<div class="p-3 border-b border-gray-200/50 dark:border-gray-700/50">
    <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">{{ 'navigation.facilities'|trans }}</h2>
        <span class="text-xs font-medium px-2 py-0.5 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-600 dark:text-gray-400">
            {{ facilities|length }} {{ 'common.total'|trans }}
        </span>
    </div>
</div>

{# Tablet: horizontal scroll; Desktop: vertical list #}
<div class="overflow-x-auto widescreen:overflow-x-hidden overflow-y-hidden widescreen:overflow-y-auto widescreen:flex-1 p-2">
    <div class="flex widescreen:flex-col gap-1 widescreen:space-y-0 min-w-max widescreen:min-w-0">
        {% for facility in facilities %}
            <button
                data-facility-id="{{ facility.id }}"
                data-facility-shift-target="facilityButton"
                data-action="click->facility-shift#selectFacility"
                class="facility-item shrink-0 widescreen:w-full p-2 widescreen:p-3 rounded-xl hover:bg-white/80 dark:hover:bg-gray-800/80 transition-all duration-200 text-left group {% if loop.first %}activeFacility{% endif %}"
            >
                <div class="flex items-center gap-2">
                    <div class="p-1.5 bg-gradient-to-br from-blue-100 to-indigo-100 dark:from-blue-900/30 dark:to-indigo-900/30 rounded-lg flex-shrink-0">
                        {{ ux_icon('lucide:building-2', { class: 'h-3.5 w-3.5 text-blue-600 dark:text-blue-400' }) }}
                    </div>
                    <div class="min-w-0">
                        <div class="text-sm font-medium text-gray-900 dark:text-white whitespace-nowrap widescreen:whitespace-normal">{{ facility.title }}</div>
                        <div class="flex items-center gap-1.5 mt-0.5">
                            <span class="text-xs font-medium px-1.5 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded">{{ facility.shortTitle }}</span>
                            <span class="hidden widescreen:inline text-xs text-gray-500 dark:text-gray-400">
                                {% if facility.shifts is defined %}
                                    {{ facility.shifts|length }} {{ 'facility_shift.shifts'|trans }}
                                {% else %}
                                    {{ 'facility_shift.no_shifts'|trans }}
                                {% endif %}
                            </span>
                        </div>
                    </div>
                    {{ ux_icon('lucide:chevron-right', { class: 'hidden widescreen:block h-4 w-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity' }) }}
                </div>
            </button>
        {% endfor %}
    </div>
</div>
