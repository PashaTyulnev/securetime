{% extends 'base.html.twig' %}

{% block title %}{{ 'switch_user.title'|trans }}{% endblock %}

{% block body %}
<div class="p-6">
    <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
            {{ 'switch_user.title'|trans }}
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
            {{ 'switch_user.description'|trans }}
        </p>

        <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-2xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl overflow-hidden">
            <ul class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
                {% for employee in employees %}
                    {% if employee.user %}
                        <li>
                            <a href="{{ path('app_dashboard', { _switch_user: employee.user.username }) }}"
                               class="flex items-center justify-between px-5 py-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors group">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-gray-600 flex items-center justify-center">
                                        {{ ux_icon('lucide:user', { class: 'w-5 h-5 text-slate-600 dark:text-gray-300' }) }}
                                    </div>
                                    <div>
                                        <span class="font-medium text-gray-900 dark:text-white group-hover:text-slate-700 dark:group-hover:text-gray-200">
                                            {{ employee.fullName }}
                                        </span>
                                        <span class="block text-xs text-gray-500 dark:text-gray-400">
                                            {{ employee.user.username }}
                                        </span>
                                    </div>
                                </div>
                                <span class="text-slate-600 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white">
                                    {{ ux_icon('lucide:log-in', { class: 'w-5 h-5' }) }}
                                </span>
                            </a>
                        </li>
                    {% endif %}
                {% else %}
                    <li class="px-5 py-8 text-center text-gray-500 dark:text-gray-400">
                        {{ 'switch_user.no_employees'|trans }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}
