{% extends 'base.html.twig' %}

{% block title %}Geschäftspartner{% endblock %}

{% block body %}

    <div data-controller="partner-company">

        <div data-partner-company-target="modalContainer"></div>

        {# ================= HEADER ================= #}
        <header class="relative
                   -mx-6 px-6
                   backdrop-blur-xl bg-white/70 dark:bg-gray-900/70
                   border-b border-gray-200/50 dark:border-gray-800/50">

            <div class="px-6 py-4 flex items-center justify-between">
                <h1 class="text-3xl font-light tracking-tight
                       bg-gradient-to-r from-slate-900 to-slate-600
                       dark:from-white dark:to-gray-400
                       bg-clip-text text-transparent">
                    Geschäftspartner
                </h1>

                {% if is_granted('ROLE_ADMIN') %}
                    <button
                        data-action="click->partner-company#openCreationModal"
                        class="app-button">
                        {{ ux_icon('lucide:handshake', { class: 'w-5 h-5' }) }}
                        <span>Geschäftspartner anlegen</span>
                    </button>
                {% endif %}
            </div>
        </header>

        {# ================= CONTENT ================= #}
        <div class="p-5">
            <turbo-frame id="partner-companies-table" src="{{ path('all_partner_company_list_component') }}">
                <div class="py-12 flex justify-center">
                    <twig:Loader/>
                </div>
            </turbo-frame>
        </div>

    </div>

{% endblock %}
