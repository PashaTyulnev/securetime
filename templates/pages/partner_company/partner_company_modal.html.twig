{% extends 'elements/modal.html.twig' %}

{% block content %}
    {% set definedPartnerCompany = partnerCompany is defined ? partnerCompany : {} %}

    <div class="px-8 py-10">
        <div class="text-center mb-8 animate-bounce-in">
            <div
                class="mx-auto h-20 w-20 flex items-center justify-center rounded-3xl bg-gradient-to-br from-slate-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 shadow-inner">
                {{ ux_icon('lucide:handshake', { class: 'h-11 w-11 text-slate-700 dark:text-gray-300' }) }}
            </div>
        </div>

        <h2 class="text-2xl font-light text-gray-900 dark:text-white mb-6 text-center">
            {{ 'navigation.partners'|trans }} {% if partnerCompany is defined %}{{ 'common.edit'|trans }}{% else %}{{ 'common.add'|trans }}{% endif %}
        </h2>

        {% include 'elements/modal_error.html.twig' with {'dataTargetName' : 'data-partner-company-target'} %}

        {% if partnerCompany is defined %}
            <form data-action="submit->partner-company#saveEdit" data-partner-company-uri-param="{{ definedPartnerCompany['@id'] }}">
        {% else %}
            <form data-action="submit->partner-company#saveNew">
        {% endif %}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

                    {% include 'elements/input.html.twig' with {
                        'title': ('partner.company_name'|trans),
                        'type': 'text',
                        'systemName': 'title',
                        'placeholder': 'Musterfirma GmbH',
                        'required': 'required',
                        'devValue': definedPartnerCompany.title|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('employee.first_name'|trans),
                        'type': 'text',
                        'systemName': 'firstName',
                        'placeholder': 'Max',
                        'required': 'required',
                        'devValue': definedPartnerCompany.firstName|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('employee.last_name'|trans),
                        'type': 'text',
                        'systemName': 'lastName',
                        'placeholder': 'Mustermann',
                        'required': 'required',
                        'devValue': definedPartnerCompany.lastName|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('common.phone'|trans),
                        'type': 'text',
                        'systemName': 'phone',
                        'placeholder': '017685412456',
                        'devValue': definedPartnerCompany.phone|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('common.email'|trans),
                        'type': 'email',
                        'systemName': 'email',
                        'placeholder': 'max@example.com',
                        'devValue': definedPartnerCompany.email|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('partner.logo_url'|trans),
                        'type': 'text',
                        'systemName': 'logoLink',
                        'placeholder': 'https://example.com/logo.png',
                        'devValue': definedPartnerCompany.logoLink|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('partner.street'|trans),
                        'type': 'text',
                        'systemName': 'address[street]',
                        'placeholder': 'Musterstraße 123',
                        'devValue': definedPartnerCompany.address.street|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('partner.zip'|trans),
                        'type': 'text',
                        'systemName': 'address[zip]',
                        'placeholder': '01234',
                        'devValue': definedPartnerCompany.address.zip|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('partner.city'|trans),
                        'type': 'text',
                        'systemName': 'address[city]',
                        'placeholder': 'Dresden',
                        'devValue': definedPartnerCompany.address.city|default('')
                    } %}

                    {% include 'elements/input.html.twig' with {
                        'title': ('partner.country'|trans),
                        'type': 'text',
                        'systemName': 'address[country]',
                        'placeholder': 'Deutschland',
                        'devValue': definedPartnerCompany.address.country|default('Deutschland')
                    } %}
                </div>

                <div class="flex justify-end space-x-4">
                    <button type="button" data-action="click->modal#hide"
                            class="px-6 py-3.5 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200">
                        {{ 'common.cancel'|trans }}
                    </button>
                    <button type="submit"
                            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-slate-800 to-slate-900 dark:from-white dark:to-gray-100 text-white dark:text-gray-900 font-medium hover:shadow-lg transform hover:scale-[1.02] transition-all duration-200">
                        {{ 'common.save'|trans }}
                    </button>
                </div>
            </form>
    </div>
{% endblock %}

