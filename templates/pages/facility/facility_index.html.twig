{% extends 'base.html.twig' %}

{% block title %}{{ 'facility.management'|trans }}{% endblock %}

{% block body %}

    <div data-controller="facility">

        <div data-facility-target="modalContainer"></div>

        {# ================= HEADER ================= #}
        <header class="relative
                   -mx-6 px-6
                   backdrop-blur-xl bg-white/70 dark:bg-gray-900/70
                   border-b border-gray-200/50 dark:border-gray-800/50">

            <div class="px-6 py-4 flex items-center justify-between">
                <h1 class="text-3xl font-light tracking-tight
                       bg-gradient-to-r from-slate-900 to-slate-600
                       dark:from-white dark:to-gray-400
                       bg-clip-text text-transparent">
                    {{ 'facility.management'|trans }}
                </h1>

                <button
                    data-action="click->facility#openCreationModal"
                    class="app-button">
                    {{ ux_icon('lucide:building-2', { class: 'w-5 h-5' }) }}
                    <span>{{ 'facility.new'|trans }}</span>
                </button>
            </div>
        </header>

        {# ================= CONTENT ================= #}
        <div class="p-5">
            <turbo-frame id="facilities-table" src="{{ path('all_facility_list_component') }}">
                <div class="py-12 flex justify-center">
                    <twig:Loader/>
                </div>
            </turbo-frame>
        </div>

    </div>


{% endblock %}
