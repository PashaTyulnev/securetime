<div
    class="bg-white/60 dark:bg-gray-900/60 backdrop-blur-xl rounded-3xl
           border border-gray-200/50 dark:border-gray-800/50 overflow-hidden">

    {# Raster-Layout: 180px Mitarbeiter, 7 Tage #}
    <div class="grid grid-cols-[180px_repeat(7,1fr)] overflow-auto">

        {# Kopfzelle Mitarbeiter #}
        <div
            class="bg-gray-50/80 dark:bg-gray-800/80
                   backdrop-blur-xl
                   px-3 py-2
                   border-b border-r border-gray-200/50 dark:border-gray-700/50
                   sticky left-0 z-10">
            <span
                class="text-[10px] font-semibold uppercase tracking-wider
                       text-gray-500 dark:text-gray-400">
                {{ 'schedule.employee'|trans }}
            </span>
        </div>

        {# Kopfzellen Tage #}
        {% for day in datesRange %}
            <div
                class="px-2 py-2 text-center
                       border-b border-r border-gray-200/50 dark:border-gray-700/50
                       backdrop-blur-xl
                       {% if day.isToday %}
                           bg-blue-50/80 dark:bg-blue-900/20
                       {% else %}
                           bg-gray-50/80 dark:bg-gray-800/80
                       {% endif %}">
                <div
                    class="text-xs font-semibold leading-tight
                           {% if day.isToday %}
                               text-blue-600 dark:text-blue-400
                           {% else %}
                               text-gray-900 dark:text-white
                           {% endif %}">
                    {{ day.name }}
                </div>
                <div class="text-[10px] leading-tight text-gray-500 dark:text-gray-400">
                    {{ day.shortName }}
                </div>
            </div>
        {% endfor %}

        {% for employee in employees %}
            <div class="contents group">

                {# Mitarbeiter-Zelle #}
                <div
                    data-action="dragover->schedule-week#onDragOver
                                 dragleave->schedule-week#onDragLeave
                                 drop->schedule-week#onDrop"
                    data-employee-uri="{{ employee['@id'] }}"
                    data-date="{{ datesRange[0].date|date('Y-m-d') }}"
                    data-whole-week="true"
                    class="bg-white/50 dark:bg-gray-900/50
                           px-3 py-2
                           border-b border-r border-gray-200/50 dark:border-gray-700/50
                           sticky left-0 z-10">

                    <div class="flex items-center gap-2">
                        <div class="p-1 bg-indigo-100 dark:bg-indigo-900/30 rounded-md">
                            {{ ux_icon('lucide:user', { class: 'h-3.5 w-3.5 text-indigo-600 dark:text-indigo-400' }) }}
                        </div>

                        <div class="leading-tight">
                            <div class="text-xs font-semibold text-gray-900 dark:text-white">
                                {{ employee.firstName|slice(0,1)|upper }}. {{ employee.lastName }}
                            </div>
                            <div class="text-[10px] text-gray-500 dark:text-gray-400">
                                {{ employee.qualification.title }}
                            </div>

                            <div
                                class="mt-0.5 grid grid-cols-3 gap-x-1
                                       text-[9px] leading-[10px]
                                       text-gray-500 dark:text-gray-400">
                                <div>
                                    <div class="font-medium">{{ 'schedule.planned'|trans }}</div>
                                    <div>{{ employee.plannedHours.regular }}h</div>
                                </div>
                                <div>
                                    <div class="font-medium">{{ 'schedule.on_call'|trans }}</div>
                                    <div>{{ employee.plannedHours.onCall }}h</div>
                                </div>
                                <div>
                                    <div class="font-semibold">{{ 'schedule.total'|trans }}</div>
                                    <div class="font-semibold">{{ employee.plannedHours.total }}h</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Tages-Zellen #}
                {% for day in 0..6 %}
                    {% set empId = employee['@id']|split('/')|last %}
                    {% set absenceKey = empId ~ '-' ~ datesRange[day].date|date('Y-m-d') %}
                    {% set absence = absenceMap[absenceKey] is defined ? absenceMap[absenceKey] : null %}
                    <div
                        data-action="dragover->schedule-week#onDragOver
                                     dragleave->schedule-week#onDragLeave
                                     drop->schedule-week#onDrop"
                        data-employee-uri="{{ employee['@id'] }}"
                        data-date="{{ datesRange[day].date|date('Y-m-d') }}"
                        class="drop-zone relative flex flex-col
       px-2 py-1.5
       min-h-[44px]
       border-b border-r border-gray-200/50 dark:border-gray-700/50
       hover:bg-gray-50/50 dark:hover:bg-gray-800/50
       transition-colors duration-200
       group/cell">
                        {% if is_admin() %}
                        <button
                            data-action="click->schedule-week#openCustomShiftModal"
                            data-employee-uri="{{ employee['@id'] }}"
                            data-date="{{ datesRange[day].date|date('Y-m-d') }}"
                            class="absolute bottom-0.5 right-0.5 opacity-0 group-hover/cell:opacity-100
                                   w-4 h-4 flex items-center justify-center
                                   rounded text-gray-400 hover:text-indigo-600 hover:bg-indigo-50
                                   dark:hover:text-indigo-400 dark:hover:bg-indigo-900/30
                                   transition-all duration-150 z-10"
                            title="{{ 'schedule.custom_shift_add'|trans|default('Außerordentliche Schicht') }}">
                            {{ ux_icon('lucide:plus', { class: 'w-3 h-3' }) }}
                        </button>
                        {% endif %}

                        {% for shift in shifts %}
                            {% if shift.date|date('Y-m-d') == datesRange[day].date|date('Y-m-d')
                                and shift.employee == employee['@id'] %}
                                {% include 'pages/schedule/components/mini_shift_pill.html.twig' with {'shift': shift} %}
                            {% endif %}
                        {% endfor %}

                        {% if absence %}
                            <div title="{% if absence.status == 'approved' %}Genehmigt{% else %}Offen (ausstehend){% endif %}: {% if absence.type == 'vacation' %}Urlaub{% elseif absence.type == 'sick' %}Krank{% else %}Nicht verfügbar{% endif %}"
                                 class="flex items-center gap-1 w-full rounded px-1 py-0.5 text-[9px] font-medium pointer-events-none mt-0.5
                                        {% if absence.status == 'approved' %}bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400
                                        {% else %}bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400{% endif %}">
                                {{ ux_icon('lucide:calendar-off', { class: 'w-2.5 h-2.5 flex-shrink-0' }) }}
                                <span class="truncate">
                                    {% if absence.type == 'vacation' %}Urlaub{% elseif absence.type == 'sick' %}Krank{% else %}N/V{% endif %}
                                    {% if absence.status == 'pending' %}(?){% endif %}
                                </span>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}

            </div>
        {% endfor %}
    </div>
</div>

{# ===== Modal: Außerordentliche Schicht ===== #}
{% if is_admin() %}
<div id="custom-shift-modal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4">
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200/50 dark:border-gray-700/50
                w-full max-w-sm p-6 space-y-4">

        <div class="flex items-center justify-between">
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                {{ 'schedule.custom_shift_title'|trans|default('Außerordentliche Schicht') }}
            </h3>
            <button data-action="click->schedule-week#closeCustomShiftModal"
                    class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                {{ ux_icon('lucide:x', { class: 'w-4 h-4' }) }}
            </button>
        </div>

        <div class="space-y-3">
            <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
                    {{ 'schedule.facility'|trans|default('Objekt') }}
                </label>
                <select id="cs-facility"
                        class="w-full rounded-lg border border-gray-300 dark:border-gray-600
                               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                               px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">{{ 'schedule.select_for_planning'|trans|default('Bitte Objekt wählen') }}</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
                    {{ 'schedule.custom_shift_name'|trans|default('Schichtname') }}
                </label>
                <input id="cs-name" type="text" placeholder="z.B. Sondereinsatz"
                       class="w-full rounded-lg border border-gray-300 dark:border-gray-600
                              bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                              px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
                        {{ 'schedule.custom_shift_from'|trans|default('Von') }}
                    </label>
                    <input id="cs-time-from" type="time"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-600
                                  bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                                  px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
                        {{ 'schedule.custom_shift_to'|trans|default('Bis') }}
                    </label>
                    <input id="cs-time-to" type="time"
                           class="w-full rounded-lg border border-gray-300 dark:border-gray-600
                                  bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                                  px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <p class="text-[10px] text-gray-400 mt-0.5">{{ 'schedule.custom_shift_open_end'|trans|default('Leer lassen = offenes Ende') }}</p>
                </div>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
                    {{ 'schedule.custom_shift_color'|trans|default('Farbe') }}
                </label>
                <div class="flex items-center gap-2">
                    <input id="cs-color" type="color" value="#6366f1"
                           class="w-10 h-9 rounded-lg border border-gray-300 dark:border-gray-600
                                  bg-white dark:bg-gray-800 cursor-pointer p-0.5">
                    <div class="flex gap-1.5 flex-wrap">
                        {% for color in ['#6366f1','#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#64748b'] %}
                            <button type="button"
                                    data-action="click->schedule-week#setCustomShiftColor"
                                    data-color="{{ color }}"
                                    class="w-5 h-5 rounded-full border-2 border-white dark:border-gray-900 shadow-sm hover:scale-110 transition-transform"
                                    style="background: {{ color }}"></button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <div class="flex gap-2 pt-1">
            <button data-action="click->schedule-week#closeCustomShiftModal"
                    class="flex-1 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600
                           text-sm text-gray-700 dark:text-gray-300
                           hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                {{ 'schedule.cancel'|trans|default('Abbrechen') }}
            </button>
            <button data-action="click->schedule-week#saveCustomShift"
                    class="flex-1 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700
                           text-sm font-medium text-white transition-colors">
                {{ 'schedule.save'|trans|default('Speichern') }}
            </button>
        </div>
    </div>
</div>
{% endif %}
