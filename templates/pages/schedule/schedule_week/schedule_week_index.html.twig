{% extends 'base.html.twig' %}

{% block body %}

    <div
        data-controller="schedule-week"
        class="min-h-screen bg-gradient-to-br
           from-gray-50 via-slate-50 to-gray-100
           dark:from-gray-950 dark:via-slate-950 dark:to-gray-900">

        {# Animated Background Gradients #}
        <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
            <div
                class="absolute -top-40 -right-40 w-80 h-80 bg-purple-500 rounded-full
               blur-3xl opacity-10 animate-blob"></div>

            <div
                class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-500 rounded-full
               blur-3xl opacity-10 animate-blob animation-delay-2000"></div>
        </div>

        {# ================= HEADER ================= #}
        <header
            class="relative z-10
           backdrop-blur-xl bg-white/70 dark:bg-gray-900/70
           border-b border-gray-200/50 dark:border-gray-800/50">

            {# Top Bar #}
            <div class="px-6 py-4 flex items-center justify-between">
                <h1
                    class="text-3xl font-light tracking-tight
                   bg-gradient-to-r from-slate-900 to-slate-600
                   dark:from-white dark:to-gray-400
                   bg-clip-text text-transparent">
                    Objektdienstplan
                </h1>

                {% include "/pages/schedule/schedule_week/week_navigation.html.twig" %}
            </div>

            {# Zeitraum / Tabs #}
            {% include '/pages/schedule/components/range_type_navigation.html.twig' %}
        </header>


        {# ================= STICKY DRAG & DROP BAR ================= #}
        <div class="sticky top-0 z-40

           border-b border-gray-200/40 dark:border-gray-800/40
           max-h-[25vh]">

            <div class="px-6 py-2 overflow-y-auto">
                {% include '/pages/schedule/components/facility_and_shift.html.twig' %}
            </div>
        </div>


        {# ================= MAIN CONTENT ================= #}
        <main class="w-full mx-auto px-6 pt-20">
            <div data-schedule-week-target="scheduleContainer">
                {# Dynamischer Wocheninhalt #}
            </div>
        </main>

    </div>

{% endblock %}
