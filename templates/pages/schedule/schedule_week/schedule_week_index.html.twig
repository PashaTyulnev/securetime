{% extends 'base.html.twig' %}

{% block body %}

    {# Hinweis für sehr kleine Bildschirme #}
    <div class="schedule:hidden flex flex-col items-center justify-center min-h-screen px-6 text-center bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-950 dark:to-gray-900">
        <div class="p-6 bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl max-w-sm w-full space-y-4">
            {{ ux_icon('lucide:monitor', { class: 'w-12 h-12 text-slate-400 mx-auto' }) }}
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">{{ 'schedule.screen_too_small_title'|trans|default('Bildschirm zu klein') }}</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">{{ 'schedule.screen_too_small_message'|trans|default('Die Einsatzplanung ist für größere Bildschirme optimiert. Bitte nutze ein Tablet im Querformat oder einen Desktop-Computer.') }}</p>
        </div>
    </div>

    <div
        data-controller="schedule-week"
        class="hidden schedule:flex flex-col bg-gradient-to-br
        h-screen
           from-gray-50 via-slate-50 to-gray-100
           dark:from-gray-950 dark:via-slate-950 dark:to-gray-900">

        {# Animated Background Gradients #}
        <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
            <div
                class="absolute -top-40 -right-40 w-80 h-80 bg-purple-500 rounded-full
               blur-3xl opacity-10 animate-blob"></div>

            <div
                class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-500 rounded-full
               blur-3xl opacity-10 animate-blob animation-delay-2000"></div>
        </div>

        {# ================= HEADER ================= #}
        <header
            class="relative z-10
           backdrop-blur-xl bg-white/70 dark:bg-gray-900/70
           border-b border-gray-200/50 dark:border-gray-800/50">

            {# Top Bar #}
            <div class="px-3 py-2 schedule:px-6 schedule:py-4 flex items-center justify-between">
                <h1
                    class="text-lg schedule:text-3xl font-light tracking-tight
                   bg-gradient-to-r from-slate-900 to-slate-600
                   dark:from-white dark:to-gray-400
                   bg-clip-text text-transparent">
                    {{ 'navigation.schedule'|trans }}
                </h1>

                {% include "/pages/schedule/schedule_week/week_navigation.html.twig" %}
            </div>

            {# Zeitraum / Tabs #}
            {% include '/pages/schedule/components/range_type_navigation.html.twig' %}
        </header>


        {# ================= STICKY DRAG & DROP BAR ================= #}
        <div class="sticky top-0
           border-b border-gray-200/40 dark:border-gray-800/40
           max-h-[25vh]">

            <div class="px-2 schedule:px-6 py-1 schedule:py-2 overflow-y-auto">
                {% include '/pages/schedule/components/facility_and_shift.html.twig' %}
            </div>
        </div>



        {# ================= MAIN CONTENT ================= #}
        <main class="flex-1 overflow-auto px-2 schedule:px-6 pt-3 schedule:pt-10">
            <div data-schedule-week-target="scheduleContainer">
                {# Dynamischer Wocheninhalt #}
            </div>
        </main>

    </div>

{% endblock %}
