{% extends 'base.html.twig' %}

{% block title %}{{ 'company.title'|trans }}{% endblock %}

{% block body %}

    <div data-controller="company">

        <div data-company-target="modalContainer"></div>

        {# ================= HEADER ================= #}
        <header
            class="relative
           backdrop-blur-xl bg-white/70 dark:bg-gray-900/70
           border-b border-gray-200/50 dark:border-gray-800/50">

            <div class="px-6 py-4 flex items-center justify-between">
                <h1>
                    {{ 'company.title'|trans }}
                </h1>

                <button
                    data-action="click->company#openCreationModal"
                    class="app-button">
                    {{ ux_icon('lucide:building-2', { class: 'w-5 h-5' }) }}
                    <span>{{ 'company.new'|trans }}</span>
                </button>
            </div>
        </header>

        {# ================= CONTENT ================= #}
        <div class="relative p-5">
            <turbo-frame id="companies-table" src="{{ path('all_company_list_component') }}">
                <div class="py-12 flex justify-center">
                    <twig:Loader/>
                </div>
            </turbo-frame>
        </div>

    </div>




{% endblock %}
