<turbo-frame id="companies-table">
    <div
        class="bg-white/80 dark:bg-gray-800/80
               backdrop-blur-xl
               rounded-2xl
               border border-gray-200/60 dark:border-gray-700/60
               shadow-sm
               overflow-hidden">

        {# ================= SUCHFILTER ================= #}
        <div class="px-6 py-4
                    border-b border-gray-200/50 dark:border-gray-700/50
                    bg-white/40 dark:bg-gray-800/40">

            <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
                <h2 class="text-lg font-medium text-gray-900 dark:text-white"></h2>

                <div class="relative">
                    <input type="text"
                           placeholder="Suchen…"
                           class="w-64
                                  bg-white/60 dark:bg-gray-700/40
                                  border border-gray-200/60 dark:border-gray-600/60
                                  rounded-xl
                                  text-sm text-gray-900 dark:text-white
                                  pl-10 pr-4 py-2
                                  focus:outline-none
                                  focus:ring-2 focus:ring-slate-500/40 dark:focus:ring-slate-400/40
                                  focus:border-transparent
                                  transition-all duration-200">

                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        {{ ux_icon('lucide:search', { class: 'h-5 w-5 text-gray-400 dark:text-gray-500' }) }}
                    </div>
                </div>
            </div>
        </div>

        {# ================= TABELLE ================= #}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50/60 dark:bg-gray-800/60">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-medium
                               text-gray-500 dark:text-gray-400
                               uppercase tracking-wider">
                        Firma
                    </th>
                    <th class="px-6 py-4 text-left text-xs font-medium
                               text-gray-500 dark:text-gray-400
                               uppercase tracking-wider">
                        Kontakte
                    </th>
                    <th class="px-6 py-4 text-right text-xs font-medium
                               text-gray-500 dark:text-gray-400
                               uppercase tracking-wider">
                        Aktionen
                    </th>
                </tr>
                </thead>

                <tbody class="divide-y divide-gray-200/40 dark:divide-gray-700/40">

                {% for company in companies %}
                    <tr class="hover:bg-gray-50/40 dark:hover:bg-gray-700/30
                               transition-colors duration-150">

                        {# Firma #}
                        <td class="px-6 py-4 align-top">
                            <div class="flex items-center gap-4">

                                <div class="w-16 h-16
                                            rounded-xl
                                            bg-gradient-to-br from-gray-100 to-gray-200
                                            dark:from-gray-700 dark:to-gray-600
                                            flex items-center justify-center
                                            overflow-hidden
                                            flex-shrink-0">

                                    {% if company.logoLink is defined and company.logoLink %}
                                        <img src="{{ company.logoLink }}"
                                             alt="{{ company.company }}"
                                             class="h-full w-full object-cover p-2">
                                    {% else %}
                                        <span class="text-sm font-medium text-gray-600 dark:text-gray-300">
                                            {{ company.company|slice(0, 2)|upper }}
                                        </span>
                                    {% endif %}
                                </div>

                                <div>
                                    <div class="text-sm font-medium text-gray-900 dark:text-white">
                                        {{ company.company }}
                                    </div>

                                    {% if company.address is defined and company.address %}
                                        <div class="text-xs text-gray-500 dark:text-gray-400">
                                            {{ company.address.street }},
                                            {{ company.address.zip }} {{ company.address.city }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>

                        {# Kontakte #}
                        <td class="px-6 py-4 align-top">
                            <div class="flex flex-col gap-2">
                                {% if company.contacts|length > 0 %}
                                    {% for contact in company.contacts|slice(0, 2) %}
                                        <div>
                                            <div class="text-sm font-medium text-gray-900 dark:text-white">
                                                {{ contact.firstName }} {{ contact.lastName }}
                                            </div>

                                            {% if contact.email %}
                                                <a href="mailto:{{ contact.email }}"
                                                   class="text-xs text-gray-500 dark:text-gray-400
                                                          hover:text-gray-700 dark:hover:text-gray-300">
                                                    {{ contact.email }}
                                                </a>
                                            {% endif %}
                                        </div>
                                    {% endfor %}

                                    {% if company.contacts|length > 2 %}
                                        <div class="text-xs text-gray-500 dark:text-gray-400">
                                            +{{ company.contacts|length - 2 }} weitere
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <span class="text-sm text-gray-500 dark:text-gray-400 italic">
                                        Keine Kontakte
                                    </span>
                                {% endif %}
                            </div>
                        </td>

                        {# Aktionen #}
                        <td class="px-6 py-4 align-top text-right whitespace-nowrap">
                            <div class="flex justify-end gap-2">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <button
                                        data-action="click->company#openEditModal"
                                        data-company-id-param="{{ company.id }}"
                                        class="p-2 rounded-lg
                                               text-gray-500 dark:text-gray-400
                                               hover:bg-gray-100/70 dark:hover:bg-gray-700/50
                                               hover:text-gray-900 dark:hover:text-white
                                               transition-colors">
                                        {{ ux_icon('lucide:edit', { class: 'h-5 w-5' }) }}
                                    </button>

                                    <button
                                        data-action="click->company#delete"
                                        data-company-uri-param="{{ company['@id'] }}"
                                        class="p-2 rounded-lg
                                               text-gray-500 dark:text-gray-400
                                               hover:bg-gray-100/70 dark:hover:bg-gray-700/50
                                               hover:text-red-600 dark:hover:text-red-400
                                               transition-colors">
                                        {{ ux_icon('lucide:trash-2', { class: 'h-5 w-5' }) }}
                                    </button>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}

                </tbody>
            </table>
        </div>

        {# ================= PAGINATION ================= #}
        <div class="px-6 py-4
                    border-t border-gray-200/50 dark:border-gray-700/50
                    bg-white/40 dark:bg-gray-800/40
                    flex justify-between items-center">

            <div class="text-sm text-gray-600 dark:text-gray-400">
                Zeige <span class="font-medium">1</span>
                bis <span class="font-medium">{{ companies|length }}</span>
                von <span class="font-medium">{{ companies|length }}</span> Einträgen
            </div>

            <div class="flex gap-2">
                <button disabled
                        class="px-4 py-2 rounded-xl
                               bg-gray-50/60 dark:bg-gray-700/40
                               text-gray-500 dark:text-gray-400
                               border border-gray-200/60 dark:border-gray-700/60
                               hover:bg-gray-100 dark:hover:bg-gray-700
                               transition-colors disabled:opacity-50">
                    {{ ux_icon('lucide:chevron-left', { class: 'h-4 w-4' }) }}
                </button>

                <button disabled
                        class="px-4 py-2 rounded-xl
                               bg-gray-50/60 dark:bg-gray-700/40
                               text-gray-500 dark:text-gray-400
                               border border-gray-200/60 dark:border-gray-700/60
                               hover:bg-gray-100 dark:hover:bg-gray-700
                               transition-colors disabled:opacity-50">
                    {{ ux_icon('lucide:chevron-right', { class: 'h-4 w-4' }) }}
                </button>
            </div>
        </div>

    </div>
</turbo-frame>
