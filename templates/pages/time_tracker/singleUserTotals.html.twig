<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    {# Linke Spalte #}
    <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl overflow-hidden">
        <div class="px-4 py-2 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/80 dark:bg-gray-800/80">
            <h3 class="text-xs font-medium text-gray-900 dark:text-white">
                {{ timeTrackingSummary.username }}
            </h3>
        </div>

        <div class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Zeitraum</span>
                    <span class="text-xs font-medium text-gray-900 dark:text-white">
                        {{ timeTrackingSummary.dateFrom|date("d.m.Y") }} – {{ timeTrackingSummary.dateTo|date("d.m.Y") }}
                    </span>
                </div>
            </div>

            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Pausen Total</span>
                    <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.totalPause }} h</span>
                </div>
            </div>

            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Gesetzliche Mindestpause</span>
                    <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.requiredPause|default('00:00') }} h</span>
                </div>
            </div>

            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Pausen-Differenz (Ist - Soll)</span>
                    <span class="text-xs font-medium {% if timeTrackingSummary.pauseDeficitMinutes|default(0) >= 0 %}text-green-600 dark:text-green-400{% else %}text-red-600 dark:text-red-400{% endif %}">
                        {{ timeTrackingSummary.pauseDeficit|default('+00:00') }} h
                    </span>
                </div>
            </div>

            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Schichten Total (ohne Pausen)</span>
                    <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.totalShiftDuration }} h</span>
                </div>
            </div>

            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Soll-Zeiten (aus Schichten)</span>
                    <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.plannedHours|default('00:00') }} h</span>
                </div>
            </div>
        </div>
    </div>

    {# Rechte Spalte #}
    <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl overflow-hidden">
        <div class="px-4 py-2 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/80 dark:bg-gray-800/80">
            <h3 class="text-xs font-medium text-gray-900 dark:text-white">
                Nachtschichten (23:00 - 06:00)
            </h3>
        </div>

        <div class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Nachtshichten Pausen Total</span>
                    <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.totalNightShiftPause }} h</span>
                </div>
            </div>

            <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600 dark:text-gray-400">Nachtshichten Total (ohne Pausen)</span>
                    <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.totalNightShiftWorkingTime }} h</span>
                </div>
            </div>

            <div class="px-4 py-2 bg-blue-50/50 dark:bg-blue-900/20">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-gray-900 dark:text-white">Nachtshichten Abzgl. Pausen</span>
                    <span class="text-xs font-bold text-gray-900 dark:text-white">{{ timeTrackingSummary.totalNightShiftWithoutPause }} h</span>
                </div>
            </div>
        </div>
    </div>
</div>

{# Total - Full Width #}
<div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl overflow-hidden">
    <div class="px-4 py-2 bg-slate-100/80 dark:bg-slate-800/80">
        <div class="flex justify-between items-center">
            <span class="text-sm font-bold text-gray-900 dark:text-white">Arbeitszeit Total (abzgl. Pausen)</span>
            <span class="text-sm font-bold text-slate-900 dark:text-white">{{ timeTrackingSummary.totalWorkingTime }} h</span>
        </div>
    </div>
</div>

{# Vergleich Ist vs. Soll #}
<div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl overflow-hidden mt-4">
    <div class="px-4 py-2 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/80 dark:bg-gray-800/80">
        <h3 class="text-xs font-medium text-gray-900 dark:text-white">
            Vergleich Ist vs. Soll
        </h3>
    </div>
    <div class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
        <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
            <div class="flex justify-between items-center">
                <span class="text-xs text-gray-600 dark:text-gray-400">Ist-Zeiten</span>
                <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.totalWorkingTime }} h</span>
            </div>
        </div>
        <div class="px-4 py-2 hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
            <div class="flex justify-between items-center">
                <span class="text-xs text-gray-600 dark:text-gray-400">Soll-Zeiten</span>
                <span class="text-xs font-medium text-gray-900 dark:text-white">{{ timeTrackingSummary.plannedHours|default('00:00') }} h</span>
            </div>
        </div>
        <div class="px-4 py-2 bg-blue-50/50 dark:bg-blue-900/20">
            <div class="flex justify-between items-center">
                <span class="text-xs font-semibold text-gray-900 dark:text-white">Differenz</span>
                <span class="text-xs font-bold {% if timeTrackingSummary.differenceMinutes|default(0) >= 0 %}text-green-600 dark:text-green-400{% else %}text-red-600 dark:text-red-400{% endif %}">
                    {{ timeTrackingSummary.differenceHours|default('+00:00') }} h
                </span>
            </div>
        </div>
    </div>
</div>
