<div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-xl rounded-3xl border border-gray-200/50 dark:border-gray-700/50 shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50/80 dark:bg-gray-800/80">
            <tr>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    {{ 'navigation.employees'|trans }}
                </th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    {{ 'common.start'|trans }}
                </th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    {{ 'common.end'|trans }}
                </th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    {{ 'common.duration'|trans }}
                </th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    {{ 'common.pause'|trans }}
                </th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    {{ 'common.working_time'|trans }}
                </th>
                <th class="px-3 py-2 w-10"></th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
            {% for trackedTime in trackedTimes %}
                <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors {% if trackedTime.autoCheckOut|default(false) %}bg-amber-50/50 dark:bg-amber-900/20 border-l-4 border-amber-500{% elseif trackedTime.isManualEntry|default(false) %}bg-blue-50/50 dark:bg-blue-900/20 border-l-4 border-blue-500{% endif %}">
                    <td class="px-3 py-2">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium text-gray-900 dark:text-white">{{ trackedTime.username }}</span>
                            {% if trackedTime.autoCheckOut|default(false) %}
                                <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300" title="{{ 'time_tracker.auto_checkout'|trans }}">
                                    {{ 'time_tracker.auto_checkout_short'|trans }}
                                </span>
                            {% endif %}
                            {% if trackedTime.isManualEntry|default(false) %}
                                <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300" title="{{ 'time_tracker.manual_entry'|trans }}">
                                    {{ 'time_tracker.manual_entry_short'|trans }}
                                </span>
                            {% endif %}
                        </div>
                        <input type="hidden" name="timeTrackerId" value="{{ trackedTime.timeTrackerId }}">
                    </td>

                    <td class="px-3 py-2">
                        <div class="flex gap-2">
                            <input type="date"
                                   class="bg-transparent border-0 text-xs text-gray-900 dark:text-white w-28 px-1 focus:outline-none focus:ring-1 focus:ring-slate-500/50 rounded"
                                   name="shiftStartDate"
                                   data-action="change->timetracker--admin#displaySaveButton"
                                   value="{{ trackedTime.shiftStart.date|date('Y-m-d') }}"
                                   {% if not is_granted('ROLE_ADMIN') %}readonly{% endif %}>

                            <input type="time"
                                   class="bg-transparent border-0 text-xs text-gray-900 dark:text-white w-16 px-1 focus:outline-none focus:ring-1 focus:ring-slate-500/50 rounded"
                                   name="shiftStartTime"
                                   data-action="change->timetracker--admin#displaySaveButton"
                                   value="{{ trackedTime.shiftStart.date|date('H:i') }}"
                                   {% if not is_granted('ROLE_ADMIN') %}readonly{% endif %}>
                        </div>
                    </td>

                    <td class="px-3 py-2">
                        <div class="flex gap-2">
                            <input type="date"
                                   class="bg-transparent border-0 text-xs text-gray-900 dark:text-white w-28 px-1 focus:outline-none focus:ring-1 focus:ring-slate-500/50 rounded"
                                   name="shiftEndDate"
                                   data-action="change->timetracker--admin#displaySaveButton"
                                   value="{{ trackedTime.shiftEnd is not null ? trackedTime.shiftEnd.date|date('Y-m-d') : '' }}"
                                   {% if not is_granted('ROLE_ADMIN') %}readonly{% endif %}>

                            <input type="time"
                                   class="bg-transparent border-0 text-xs text-gray-900 dark:text-white w-16 px-1 focus:outline-none focus:ring-1 focus:ring-slate-500/50 rounded"
                                   name="shiftEndTime"
                                   data-action="change->timetracker--admin#displaySaveButton"
                                   value="{{ trackedTime.shiftEnd is not null ? trackedTime.shiftEnd.date|date('H:i') : '' }}"
                                   {% if not is_granted('ROLE_ADMIN') %}readonly{% endif %}>
                        </div>
                    </td>

                    <td class="px-3 py-2">
                        {% if trackedTime.shiftDuration is not null %}
                            <span class="text-xs text-gray-900 dark:text-white">{{ trackedTime.shiftDuration }}</span>
                        {% endif %}
                    </td>

                    <td class="px-3 py-2">
                        <span class="text-xs text-gray-900 dark:text-white">{{ trackedTime.pauseDuration }}</span>
                    </td>

                    <td class="px-3 py-2">
                        {% if trackedTime.totalWorkingTime is not null %}
                            <span class="text-xs font-semibold text-gray-900 dark:text-white">{{ trackedTime.totalWorkingTime }}</span>
                        {% endif %}
                    </td>

                    <td class="px-3 py-2">
                        {% if is_granted("ROLE_ADMIN") %}
                            <div class="flex items-center gap-1">
                                <button
                                    class="hidden saveChangedTimeEntryButton p-1.5 rounded-lg hover:bg-green-100 dark:hover:bg-green-900/30 text-green-600 dark:text-green-400 transition-all"
                                    data-action="click->timetracker--admin#saveChangedTimeEntry">
                                    {{ ux_icon('lucide:save', { class: 'h-4 w-4' }) }}
                                </button>
                                <button type="button"
                                    class="p-1.5 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 text-red-600 dark:text-red-400 transition-all"
                                    title="{{ 'time_tracker.delete_entry'|trans }}"
                                    data-delete-confirm="{{ 'time_tracker.delete_confirm'|trans }}"
                                    data-delete-success="{{ 'time_tracker.delete_success'|trans }}"
                                    data-action="click->timetracker--admin#deleteTimeEntry">
                                    {{ ux_icon('lucide:trash-2', { class: 'h-4 w-4' }) }}
                                </button>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if timeTrackingSummary is defined %}
        <div class="px-4 py-3 border-t border-gray-200/50 dark:border-gray-700/50 bg-gray-50/60 dark:bg-gray-800/60">
            <div class="flex flex-wrap justify-end gap-4 text-[11px]">
                <div class="flex items-center gap-1">
                    <span class="text-gray-600 dark:text-gray-400">{{ 'common.actual_hours'|trans }}:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">{{ timeTrackingSummary.totalWorkingTime }} h</span>
                </div>
                <div class="flex items-center gap-1">
                    <span class="text-gray-600 dark:text-gray-400">{{ 'common.planned_hours'|trans }}:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">{{ timeTrackingSummary.plannedHours|default('00:00') }} h</span>
                </div>
                <div class="flex items-center gap-1">
                    <span class="text-gray-600 dark:text-gray-400">{{ 'common.required_break'|trans }}:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">{{ timeTrackingSummary.requiredPause|default('00:00') }} h</span>
                </div>
                <div class="flex items-center gap-1">
                    <span class="text-gray-600 dark:text-gray-400">{{ 'common.break_difference'|trans }}:</span>
                    <span class="font-semibold {% if timeTrackingSummary.pauseDeficitMinutes|default(0) >= 0 %}text-green-600 dark:text-green-400{% else %}text-red-600 dark:text-red-400{% endif %}">
                        {{ timeTrackingSummary.pauseDeficit|default('+00:00') }} h
                    </span>
                </div>
                <div class="flex items-center gap-1">
                    <span class="text-gray-600 dark:text-gray-400">{{ 'common.difference'|trans }}:</span>
                    <span class="font-semibold {% if timeTrackingSummary.differenceMinutes|default(0) >= 0 %}text-green-600 dark:text-green-400{% else %}text-red-600 dark:text-red-400{% endif %}">
                        {{ timeTrackingSummary.differenceHours|default('+00:00') }} h
                    </span>
                </div>
            </div>
        </div>
    {% endif %}
</div>
