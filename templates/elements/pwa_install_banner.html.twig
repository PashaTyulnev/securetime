<div data-controller="pwa-install"
     data-pwa-install-install-text-value="{{ 'pwa.install'|trans }}"
     data-pwa-install-dismiss-text-value="{{ 'pwa.dismiss'|trans }}"
     data-pwa-install-description-value="{{ 'pwa.install_description'|trans }}"
     data-pwa-install-target="banner"
     class="hidden fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:w-96 z-50">
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-2xl p-4 backdrop-blur-xl">
        <div class="flex items-start gap-3">
            <div class="flex-shrink-0">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-100 to-slate-200 dark:from-gray-700 dark:to-gray-600 flex items-center justify-center">
                    {{ ux_icon('lucide:download', { class: 'w-6 h-6 text-slate-700 dark:text-gray-300' }) }}
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-1">
                    {{ 'pwa.install_title'|trans }}
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">
                    {{ 'pwa.install_description'|trans }}
                </p>
                <div class="flex gap-2">
                    <button type="button"
                            data-pwa-install-target="installButton"
                            data-action="click->pwa-install#install"
                            class="flex-1 px-4 py-2 text-xs font-medium rounded-xl bg-gradient-to-r from-slate-800 to-slate-900 dark:from-white dark:to-gray-100 text-white dark:text-gray-900 hover:shadow-lg transform hover:scale-[1.02] transition-all duration-200">
                        {{ 'pwa.install'|trans }}
                    </button>
                    <button type="button"
                            data-pwa-install-target="dismissButton"
                            data-action="click->pwa-install#dismiss"
                            class="px-4 py-2 text-xs font-medium rounded-xl border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        {{ 'pwa.dismiss'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes slide-up {
        from {
            transform: translateY(100%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    .animate-slide-up {
        animation: slide-up 0.3s ease-out;
    }
</style>
