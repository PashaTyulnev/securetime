<div class="relative" data-controller="dropdown">
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
        {{ title }}
    </label>

    <button
        type="button"
        data-dropdown-target="trigger"
        class="w-full inline-flex items-center justify-between
               bg-gray-50 dark:bg-gray-800
               border border-gray-200 dark:border-gray-700
               text-gray-900 dark:text-white
               text-sm font-medium
               rounded-lg px-3 py-2">

        <span class="truncate" data-dropdown-target="label">
            {{ defaultOption ?? 'Auswählen' }}
        </span>

        <svg class="w-2.5 h-2.5 ms-3" viewBox="0 0 10 6">
            <path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="2"/>
        </svg>
    </button>

    <div
        data-dropdown-target="menu"
        class="z-10 hidden mt-1 w-full
               bg-white dark:bg-gray-700
               rounded-lg shadow-sm">

        <ul class="p-3 space-y-3 text-sm">
            {% for option in options %}
                <li>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input
                            type="checkbox"
                            name="{{ systemName }}[]"
                            value="{{ option.value }}"
                            {% if option.value in devValue %}checked{% endif %}
                            {% if formId is defined and formId %}
                                form="{{ formId }}"
                            {% endif %}
                            data-action="
                                change->dropdown#updateLabel
                               {% if updateAction is defined and updateAction %} change->{{ updateAction }}{% endif %}
                            "
                            class="w-4 h-4 rounded">

                        <span>{{ option.label }}</span>
                    </label>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
