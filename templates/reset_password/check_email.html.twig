        href="{{ path('app_login') }}"
        class="block w-full text-center py-4 px-6 rounded-2xl bg-gray-50 dark:bg-gray-800/50 text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 border border-gray-200 dark:border-gray-700"
        >
