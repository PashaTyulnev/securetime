{% extends 'reset_password/base.html.twig' %}

{% block title %}E-Mail versendet{% endblock %}

{% block card_content %}
    {# Success Icon #}
    <div class="flex justify-center mb-6">
        <div class="h-20 w-20 rounded-full bg-gradient-to-br from-green-400 to-green-600 flex items-center justify-center shadow-lg animate-bounce-in">
            <svg class="h-10 w-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>
    </div>

    <div class="text-center">
        <h1 class="text-3xl font-thin text-gray-900 dark:text-white mb-4">
            E-Mail versendet
        </h1>
        <p class="text-gray-600 dark:text-gray-300 text-base font-light leading-relaxed mb-6">
            Falls ein Konto mit Ihrer E-Mail-Adresse existiert, haben wir Ihnen eine E-Mail mit einem Link zum Zurücksetzen Ihres Passworts gesendet.
        </p>
    </div>

    {# Info Box #}
    <div class="rounded-2xl bg-blue-50/80 dark:bg-blue-900/20 p-5 border border-blue-200/50 dark:border-blue-800/50 backdrop-blur mb-6">
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-500 dark:text-blue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm text-blue-700 dark:text-blue-400 font-light leading-relaxed">
                    <strong class="font-medium">Gültigkeitsdauer:</strong> Der Link ist 1 Stunde gültig.
                </p>
            </div>
        </div>
    </div>

    {# Warning Box #}
    <div class="rounded-2xl bg-amber-50/80 dark:bg-amber-900/20 p-5 border border-amber-200/50 dark:border-amber-800/50 backdrop-blur mb-8">
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-amber-500 dark:text-amber-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm text-amber-700 dark:text-amber-400 font-light leading-relaxed">
                    Falls Sie keine E-Mail erhalten, überprüfen Sie bitte Ihren Spam-Ordner.
                </p>
            </div>
        </div>
    </div>

    {# Actions #}
    <div class="space-y-3">

