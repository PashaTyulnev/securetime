{# ================================
   Mobile Toggle Button (Header)
   ================================ #}

<button data-drawer-target="separator-sidebar"
        data-drawer-toggle="separator-sidebar"
        aria-controls="separator-sidebar"
        type="button"
        class="bg-white/70 dark:bg-gray-900 inline-flex items-center p-4 text-sm text-gray-500 sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600">
    <span class="sr-only">Open sidebar</span>
    <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
    </svg>
</button>

{# ================================
   Sidebar (Flowbite Drawer)
   ================================ #}

{# aktuelle Route #}
{% set current_route = app.request.attributes.get('_route') %}

{# Klassen #}
{% set default_classes =
    'group flex items-center space-x-3 px-5 py-2 rounded-2xl
     text-gray-600 dark:text-gray-400
     hover:bg-gray-100/80 dark:hover:bg-gray-700/50
     transition-all duration-200 relative overflow-hidden'
%}

{% set active_classes =
    'group flex items-center space-x-3 px-5 py-2 rounded-2xl
     bg-gradient-to-r from-slate-100 to-gray-100
     dark:from-gray-700/50 dark:to-gray-700/30
     text-slate-900 dark:text-white
     font-medium shadow-sm relative'
%}

<aside
    id="separator-sidebar"
    class="fixed top-0 left-0 z-40 w-72 h-screen
           transition-transform -translate-x-full sm:translate-x-0
           bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl
           border-r border-gray-200/50 dark:border-gray-700/50
           flex flex-col"
    aria-label="Sidebar"
>

    {# ================================
       Header / Logo
       ================================ #}
    <div class="p-7 pb-6">
        <div class="flex items-center space-x-4">
            <div class="relative">
                <div class="w-12 h-12">
                    {% include "logo.svg" %}
                </div>
                <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-green-500 rounded-full border-2 border-white dark:border-gray-900"></div>
            </div>
            <div>
                <h2 class="text-xl font-light text-gray-900 dark:text-white tracking-tight">
                    SecureTime
                </h2>
                <p class="text-xs font-light text-gray-500 dark:text-gray-400 mt-0.5">
                    DWSD • Objektsicherheit
                </p>
            </div>
        </div>
    </div>

    {# ================================
       Navigation
       ================================ #}
    <nav class="flex-1 overflow-y-auto px-5 pb-5 scrollbar-thin">

        <ul class="space-y-1">

            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_dashboard', icon:'lucide:layout-dashboard', title:'Dashboard' } %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_facility_shift', icon:'lucide:calendar-cog', title:'Objekt-Schichten' } %}
            {% endif %}

            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_time_tracking_index', icon:'lucide:clock', title:'Arbeitszeiten' } %}
            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_schedule', icon:'lucide:calendar-clock', title:'Einsatzplanung' } %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_company', icon:'lucide:lock', title:'Auftraggeber' } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_facility', icon:'lucide:building-2', title:'Objekte' } %}
            {% endif %}

            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_employees', icon:'lucide:users', title:'Mitarbeiter' } %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_contacts', icon:'lucide:contact', title:'Kontakte' } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_partner_company', icon:'lucide:handshake', title:'Geschäftspartner' } %}
            {% endif %}

            {# Archiv-Menü mit Unterpunkten #}
            <li class="mt-2">
                <div class="px-5 py-2 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
                    Archiv
                </div>
            </li>
            {% include 'navigation/navigation_submenu.html.twig'
                with { route:'app_archive_employees', icon:'lucide:users', title:'Mitarbeiter' } %}
            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_submenu.html.twig'
                    with { route:'app_archive_facilities', icon:'lucide:building-2', title:'Objekte' } %}
            {% endif %}

        </ul>

        <div class="my-6 border-t border-gray-200/50 dark:border-gray-700/50"></div>

    </nav>


    {# ================================
       Dark Mode Toggle
       ================================ #}
    <div class="px-5 pb-4 border-t border-gray-200/50 dark:border-gray-700/50 pt-4">
        <button
            data-action="click->menu#toggleDarkMode"
            class="w-full flex items-center justify-between px-5 py-3 rounded-2xl
                   bg-gray-100/50 dark:bg-gray-800/50
                   hover:bg-gray-200/70 dark:hover:bg-gray-700/70
                   transition-all duration-200"
        >
            <div class="flex items-center space-x-3">
                {{ ux_icon('lucide:moon', { class:'w-5 h-5' }) }}
                <span class="text-sm">Dark Mode</span>
            </div>
            <div class="w-11 h-6 bg-gray-300 dark:bg-gray-600 rounded-full relative">
                <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full transition-all dark:left-[1.375rem]"></div>
            </div>
        </button>
    </div>

    {# ================================
       User Profile
       ================================ #}
    <div class="p-5 border-t border-gray-200/50 dark:border-gray-700/50 bg-gray-50/50 dark:bg-gray-800/30">
        <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-full bg-gray-300 dark:bg-gray-700 flex items-center justify-center">
                {{ ux_icon('lucide:user', { class:'w-5 h-5' }) }}
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium truncate">{{ app.user.username }}</p>
                <p class="text-xs text-gray-500 truncate">{{ app.user.email }}</p>
            </div>
            <a href="{{ path('app_logout') }}" class="p-2 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700">
                {{ ux_icon('lucide:log-out', { class:'w-5 h-5' }) }}
            </a>
        </div>
    </div>

</aside>

{# ================================
   Flowbite Backdrop (optional)
   ================================ #}
<div data-drawer-backdrop class="fixed inset-0 z-30 bg-black/50 hidden"></div>

{# ================================
   Scrollbar Styles
   ================================ #}
<style>
    .scrollbar-thin::-webkit-scrollbar { width: 6px; }
    .scrollbar-thin::-webkit-scrollbar-thumb {
        background: rgba(156,163,175,.5);
        border-radius: 3px;
    }
    .dark .scrollbar-thin::-webkit-scrollbar-thumb {
        background: rgba(75,85,99,.5);
    }
</style>
