{# ================================
   Mobile Toggle Button (Header)
   ================================ #}

<button data-drawer-target="separator-sidebar"
        data-drawer-toggle="separator-sidebar"
        aria-controls="separator-sidebar"
        type="button"
        class="bg-white/70 dark:bg-gray-900 inline-flex items-center p-4 text-sm text-gray-500 sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600">
    <span class="sr-only">Open sidebar</span>
    <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path clip-rule="evenodd" fill-rule="evenodd"
              d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
    </svg>
</button>

{# ================================
   Sidebar (Flowbite Drawer)
   ================================ #}

{# aktuelle Route #}
{% set current_route = app.request.attributes.get('_route') %}

{# Klassen #}
{% set default_classes =
    'group flex items-center space-x-3 px-5 py-2 rounded-2xl
     text-gray-600 dark:text-gray-400
     hover:bg-gray-100/80 dark:hover:bg-gray-700/50
     transition-all duration-200 relative overflow-hidden' %}

{% set active_classes =
    'group flex items-center space-x-3 px-5 py-2 rounded-2xl
     bg-gradient-to-r from-slate-100 to-gray-100
     dark:from-gray-700/50 dark:to-gray-700/30
     text-slate-900 dark:text-white
     font-medium shadow-sm relative' %}

<aside
    id="separator-sidebar"
    class="fixed top-0 left-0 z-40 w-72 h-screen
           transition-transform -translate-x-full sm:translate-x-0
           bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl
           border-r border-gray-200/50 dark:border-gray-700/50
           flex flex-col"
    aria-label="Sidebar"
>

    {# ================================
       Header / Logo
       ================================ #}
    <div id="sidebar-header" class="flex items-center justify-between pl-10 pr-3 py-5">
        <div class="sidebar-logo-area flex items-center space-x-3 min-w-0">
            <div class="relative flex-shrink-0">
                <div class="w-9 h-9">
                    <img src="{{ asset('logo_mini.svg') }}" alt="SecureTime Logo"
                         class="w-full h-full object-contain dark:hidden">
                    <img src="{{ asset('logo_mini_white.svg') }}" alt="SecureTime Logo"
                         class="w-full h-full object-contain hidden dark:block">
                </div>
                <div class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-green-500 rounded-full border-2 border-white dark:border-gray-900"></div>
            </div>
            <div class="sidebar-text min-w-0">
                <h2 class="text-lg font-light text-gray-900 dark:text-white tracking-tight whitespace-nowrap">
                    {{ 'app.name'|trans }}
                </h2>
                <p class="text-xs font-light text-gray-500 dark:text-gray-400 whitespace-nowrap">
                    {{ 'app.subtitle'|trans }}
                </p>
            </div>
        </div>
        <button id="sidebar-toggle"
                type="button"
                title="{{ 'navigation.toggle_sidebar'|trans|default('Menü ein-/ausklappen') }}"
                class="flex-shrink-0 p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700/50 transition-colors sm:flex hidden">
            <span id="sidebar-toggle-close">{{ ux_icon('lucide:panel-left-close', { class: 'w-5 h-5' }) }}</span>
            <span id="sidebar-toggle-open">{{ ux_icon('lucide:panel-left-open', { class: 'w-5 h-5' }) }}</span>
        </button>
    </div>

    {# ================================
       Navigation
       ================================ #}
    <nav class="flex-1 overflow-y-auto px-5 pb-5 scrollbar-thin">

        <ul class="space-y-1">

            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_dashboard', icon:'lucide:layout-dashboard', title:('navigation.dashboard'|trans) } %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_facility_shift', icon:'lucide:calendar-cog', title:('navigation.facility_shifts'|trans) } %}
            {% endif %}

            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_time_tracking_index', icon:'lucide:clock', title:('navigation.working_hours'|trans) } %}

            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_my_absences', icon:'lucide:calendar-off', title:('navigation.absences'|trans) } %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_absences', icon:'lucide:shield-check', title:('navigation.absences_admin'|trans) } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_schedule', icon:'lucide:calendar-clock', title:('navigation.schedule'|trans) } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_company', icon:'lucide:lock', title:('navigation.client'|trans) } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_facility', icon:'lucide:building-2', title:('navigation.facilities'|trans) } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PARTNER_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_employees', icon:'lucide:users', title:('navigation.employees'|trans) } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_contacts', icon:'lucide:contact', title:('navigation.contacts'|trans) } %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_partner_company', icon:'lucide:handshake', title:('navigation.partners'|trans) } %}
            {% endif %}

            {# Archiv-Menü mit Unterpunkten - nur für Admins #}
            {% if is_granted('ROLE_ADMIN') %}
                <li class="mt-2 sidebar-text">
                    <div
                        class="px-5 py-2 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
                        {{ 'navigation.archive'|trans }}
                    </div>
                </li>
                {% include 'navigation/navigation_submenu.html.twig'
                    with { route:'app_archive_employees', icon:'lucide:users', title:('navigation.employees'|trans) } %}
                {% include 'navigation/navigation_submenu.html.twig'
                    with { route:'app_archive_facilities', icon:'lucide:building-2', title:('navigation.facilities'|trans) } %}
            {% endif %}

            {% include 'navigation/navigation_element.html.twig'
                with { route:'app_settings', icon:'lucide:settings', title:('navigation.settings'|trans) } %}

            {% if is_granted('ROLE_ADMIN') %}
                <li class="mt-2 sidebar-text">
                    <div
                        class="px-5 py-2 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
                        {{ 'navigation.admin'|trans|default('Admin') }}
                    </div>
                </li>
                {% include 'navigation/navigation_element.html.twig'
                    with { route:'app_switch_user', icon:'lucide:user-cog', title:('switch_user.title'|trans) } %}
            {% endif %}

        </ul>

        <div class="my-6 border-t border-gray-200/50 dark:border-gray-700/50"></div>

    </nav>

    {# ================================
       User Profile
       ================================ #}
    <div id="sidebar-user-profile" class="p-5 border-t border-gray-200/50 dark:border-gray-700/50 bg-gray-50/50 dark:bg-gray-800/30">
        <div class="sidebar-user-area flex items-center space-x-3">
            <a href="{{ path('app_logout') }}"
               title="{{ 'navigation.logout'|trans|default('Abmelden') }}"
               class="sidebar-user-icon flex-shrink-0 w-9 h-9 rounded-full bg-gray-300 dark:bg-gray-700 flex items-center justify-center hover:bg-gray-400 dark:hover:bg-gray-600 transition-colors">
                {{ ux_icon('lucide:user', { class:'w-5 h-5' }) }}
            </a>
            <div class="sidebar-text flex-1 min-w-0">
                <p class="text-sm font-medium truncate">{{ app.user.username }}</p>
                <p class="text-xs text-gray-500 truncate">{{ app.user.email }}</p>
            </div>
            <a href="{{ path('app_logout') }}" class="sidebar-text p-2 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700">
                {{ ux_icon('lucide:log-out', { class:'w-5 h-5' }) }}
            </a>
        </div>
    </div>

</aside>

{# ================================
   Flowbite Backdrop (optional)
   ================================ #}
<div data-drawer-backdrop class="fixed inset-0 z-30 bg-black/50 hidden"></div>

{# ================================
   Styles
   ================================ #}
<style>
    .scrollbar-thin::-webkit-scrollbar { width: 6px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(156,163,175,.5); border-radius: 3px; }
    .dark .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(75,85,99,.5); }

    /* ===== Sidebar collapse ===== */
    #separator-sidebar {
        transition: width 0.25s cubic-bezier(0.4,0,0.2,1);
        width: 18rem;
    }
    @media (min-width: 640px) {
        #main-content { margin-left: 18rem; transition: margin-left 0.25s cubic-bezier(0.4,0,0.2,1); }
        html.sidebar-collapsed #main-content { margin-left: 4rem; }
    }
    html.sidebar-collapsed #separator-sidebar { width: 4rem; }

    /* Text ausblenden */
    html.sidebar-collapsed .sidebar-text { display: none; }

    /* Header im eingeklappten Zustand */
    html.sidebar-collapsed #sidebar-header {
        justify-content: center;
        padding: 0.75rem 0.5rem;
    }
    html.sidebar-collapsed .sidebar-logo-area { display: none; }

    /* Toggle-Button: Icon wechseln */
    html:not(.sidebar-collapsed) #sidebar-toggle-open { display: none; }
    html.sidebar-collapsed #sidebar-toggle-close { display: none; }

    /* Nav-Links zentrieren */
    html.sidebar-collapsed .sidebar-nav-link {
        padding-left: 0 !important;
        padding-right: 0 !important;
        justify-content: center !important;
    }
    html.sidebar-collapsed .sidebar-nav-inner {
        justify-content: center !important;
    }
    html.sidebar-collapsed .sidebar-nav-inner > * + * { margin-left: 0 !important; }

    /* User-Bereich zentrieren */
    html.sidebar-collapsed .sidebar-user-area { justify-content: center; }
    html.sidebar-collapsed .sidebar-user-icon {
        width: 2.25rem; height: 2.25rem;
    }

    /* Nav-Padding im eingeklappten Zustand */
    html.sidebar-collapsed #separator-sidebar nav {
        padding-left: 0.25rem;
        padding-right: 0.25rem;
    }

    /* User-Bereich Padding */
    html.sidebar-collapsed #sidebar-user-profile {
        padding: 0.5rem;
    }

    /* Trennlinie ausblenden */
    html.sidebar-collapsed #separator-sidebar .my-6 { display: none; }

    /* Tooltips im eingeklappten Zustand */
    html.sidebar-collapsed #separator-sidebar li[data-sidebar-title] { position: relative; }
    html.sidebar-collapsed #separator-sidebar li[data-sidebar-title]:hover::after {
        content: attr(data-sidebar-title);
        position: absolute;
        left: calc(100% + 0.5rem);
        top: 50%;
        transform: translateY(-50%);
        background: rgba(17,24,39,0.95);
        color: #fff;
        padding: 0.25rem 0.75rem;
        border-radius: 0.5rem;
        white-space: nowrap;
        font-size: 0.875rem;
        z-index: 200;
        pointer-events: none;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.15);
    }
    .dark html.sidebar-collapsed #separator-sidebar li[data-sidebar-title]:hover::after {
        background: rgba(31,41,55,0.98);
    }
</style>

{# ================================
   Sidebar Toggle JS
   ================================ #}
<script>
    (function () {
        var btn = document.getElementById('sidebar-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
            var collapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebarCollapsed', collapsed ? 'true' : 'false');
        });
    })();
</script>
