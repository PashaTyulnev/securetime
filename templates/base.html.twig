<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#020617">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="SecureTime">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/logo.png">
    <title>{{ 'base.title'|trans }}</title>
    <link rel="icon" type="image/svg+xml" href="/logo_white.svg">

    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% block stylesheets %}{% endblock %}
</head>

<script>
    document.documentElement.classList.add('dark');
    if (localStorage.getItem('sidebarCollapsed') === 'true') {
        document.documentElement.classList.add('sidebar-collapsed');
    }
</script>

<body class="relative min-h-screen">
{% set current_route = app.request.attributes.get('_route') %}
{% set hide_on_routes = [
    'app_login',
    'app_register_google_auth',
    'app_2fa_manual',
    'app_2fa_manual_check'
] %}

{% set hasSidebar =
    is_granted('IS_AUTHENTICATED_FULLY')
    and app.user
    and current_route not in hide_on_routes
%}
<!-- 🌌 GLOBAL BACKGROUND -->
<div class="fixed inset-0 -z-10 bg-gradient-to-br
            from-gray-50 via-slate-50 to-gray-100
            dark:from-gray-950 dark:via-slate-950 dark:to-gray-900">

    <!-- Animated blobs -->
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-purple-500 rounded-full
                mix-blend-multiply dark:mix-blend-screen blur-3xl
                opacity-10 dark:opacity-20 animate-blob"></div>

    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-500 rounded-full
                mix-blend-multiply dark:mix-blend-screen blur-3xl
                opacity-10 dark:opacity-20 animate-blob animation-delay-2000"></div>
</div>

<div class="flex min-h-screen flex-col">
    {% if hasSidebar %}
        {% include 'navigation/navigation.html.twig' %}
    {% endif %}

    <main id="main-content" class="flex-1 min-h-0 overflow-y-auto scrollbar-thin">

        {% if is_granted('ROLE_PREVIOUS_ADMIN') or is_granted('IS_IMPERSONATOR') %}
            <div class="sticky top-0 z-30 px-4 py-2 bg-amber-500/90 dark:bg-amber-600/90 text-amber-950 dark:text-amber-100 text-sm font-medium flex items-center justify-center gap-4 flex-wrap">
                <span>{{ 'switch_user.impersonating'|trans({'%name%': app.user.username}) }}</span>
                <a href="{{ path('app_dashboard', { _switch_user: '_exit' }) }}"
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-900/20 dark:bg-amber-950/30 hover:bg-amber-900/30 dark:hover:bg-amber-950/50 transition-colors font-semibold">
                    {{ ux_icon('lucide:log-out', { class: 'w-4 h-4' }) }}
                    {{ 'switch_user.exit'|trans }}
                </a>
            </div>
        {% endif %}

        <div class="w-full">
            {% include 'elements/toast.html.twig' %}
            {% include 'elements/pwa_install_banner.html.twig' %}
            {% block body %}{% endblock %}
        </div>
    </main>
</div>

<style>
    @keyframes blob {
        0%   { transform: translate(0, 0) scale(1); }
        33%  { transform: translate(30px, -50px) scale(1.1); }
        66%  { transform: translate(-20px, 20px) scale(0.9); }
        100% { transform: translate(0, 0) scale(1); }
    }
    .animate-blob {
        animation: blob 7s infinite;
    }
    .animation-delay-2000 {
        animation-delay: 2s;
    }
</style>

</body>
</html>
