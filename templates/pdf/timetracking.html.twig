<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zeiterfassung</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 15mm;
            font-size: 11px;
            color: #333;
            line-height: 1.4;
        }

        .header {
            position: relative;
            margin-bottom: 20px;
            padding-top: 5mm;
            min-height: 80px;
        }

        .header-top {
            position: relative;
            margin-bottom: 15px;
            min-height: 80px;
        }

        .header-left {
            width: 70%;
            padding-right: 160px;
        }

        .header-right {
            position: absolute;
            top: 0;
            right: 0;
            text-align: right;
            width: 150px;
        }

        .logo {
            max-width: 150px;
            max-height: 75px;
            height: auto;
            width: auto;
            display: block;
        }

        .header h1 {
            margin: 0 0 8px 0;
            font-size: 16px;
            font-weight: bold;
        }

        .company-info {
            margin-bottom: 0;
            font-size: 10px;
            color: #666;
        }

        .summary-top {
            display: table;
            width: 100%;
            margin-bottom: 15px;
            padding: 8px 12px;
            background-color: #f5f5f5;
            border: 1px solid #ddd;
            border-collapse: separate;
            border-spacing: 0;
        }

        .summary-top-item {
            display: table-cell;
            padding: 0 15px;
            font-size: 10px;
            vertical-align: middle;
        }

        .summary-top-item:first-child {
            padding-left: 0;
        }

        .summary-top-item:last-child {
            padding-right: 0;
        }

        .summary-top-item strong {
            display: block;
            margin-bottom: 2px;
            font-size: 9px;
            color: #666;
            font-weight: normal;
        }

        .summary-top-item span {
            display: block;
            font-size: 12px;
            font-weight: bold;
            color: #333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            table-layout: fixed;
        }

        th, td {
            border: 1px solid #333;
            padding: 6px 8px;
            text-align: left;
            vertical-align: middle;
        }

        th {
            background-color: #f0f0f0;
            font-weight: bold;
            text-align: center;
            font-size: 10px;
            padding: 8px 6px;
        }

        td {
            font-size: 10px;
            word-wrap: break-word;
        }

        /* Spaltenbreiten */
        th:nth-child(1), td:nth-child(1) { width: 12%; text-align: center; } /* Datum */
        th:nth-child(2), td:nth-child(2) { width: 25%; } /* Objekt */
        th:nth-child(3), td:nth-child(3) { width: 12%; text-align: center; } /* Beginn */
        th:nth-child(4), td:nth-child(4) { width: 12%; text-align: center; } /* Ende */
        th:nth-child(5), td:nth-child(5) { width: 12%; text-align: center; } /* Pause */
        th:nth-child(6), td:nth-child(6) { width: 15%; text-align: center; } /* Dauer */

        .working-time {
            font-weight: bold;
            text-align: center;
        }

        .signature-section {
            margin-top: 30px;
            display: table;
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .signature-field {
            display: table-cell;
            width: 45%;
            text-align: center;
            padding: 0 10px;
        }

        .signature-line {
            border-bottom: 1px solid #333;
            height: 35px;
            margin-bottom: 5px;
        }

        .signature-label {
            font-size: 9px;
            color: #666;
        }

        .summary-section {
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .summary-section h3 {
            margin: 0 0 10px 0;
            font-size: 12px;
            font-weight: bold;
            border-bottom: 1px solid #333;
            padding-bottom: 3px;
        }

        .summary-table {
            width: 50%;
            border: none;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .summary-table td {
            border: none;
            padding: 4px 10px 4px 0;
            border-bottom: 1px dotted #ccc;
            font-size: 10px;
        }

        .summary-table td:last-child {
            text-align: right;
            font-weight: bold;
        }

        .summary-value {
            min-width: 70px;
            text-align: right;
        }

        @media print {
            body {
                margin: 15mm;
            }
            .signature-section {
                page-break-inside: avoid;
            }
            table {
                page-break-inside: auto;
            }
            tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }
        }
    </style>
</head>
<body>
<div class="header">
    <div class="header-top">
        <div class="header-left">
            <h1>Zeiterfassung</h1>
            <div class="company-info">
                <strong>Zeitraum:</strong> {{ totals.dateFrom|date('d.m.Y') }} - {{ totals.dateTo|date('d.m.Y') }}
            </div>
        </div>
        <div class="header-right">
            {% if logoBase64 is defined and logoBase64 is not null %}
                <img src="{{ logoBase64 }}" alt="Logo" class="logo">
            {% endif %}
        </div>
    </div>

    <div class="summary-top">
        <div class="summary-top-item">
            <strong>Ist-Stunden:</strong>
            <span>{{ totals.totalWorkingTime }} h</span>
        </div>
        <div class="summary-top-item">
            <strong>Soll-Stunden:</strong>
            <span>{{ totals.plannedHours|default('00:00') }} h</span>
        </div>
        <div class="summary-top-item">
            <strong>Differenz:</strong>
            <span>{{ totals.differenceHours|default('+00:00') }} h</span>
        </div>
    </div>
</div>

<table>
    <thead>
    <tr>
        <th>Datum</th>
        <th>Objekt</th>
        <th>Beginn<br>Uhrzeit</th>
        <th>Ende<br>Uhrzeit</th>
        <th>Pause</th>
        <th>Arbeitszeit</th>
    </tr>
    </thead>
    <tbody>
    {% for trackedTime in trackedTimes %}
        <tr>
            <td>{{ trackedTime.shiftStart.date|date('d.m.Y') }}</td>
            <td>{{ trackedTime.facilityName|default('-') }}</td>
            <td>
                {% if trackedTime.shiftStart is not null %}
                    {{ trackedTime.shiftStart.date|date('H:i') }}
                {% endif %}
            </td>
            <td>
                {% if trackedTime.shiftEnd is not null %}
                    {{ trackedTime.shiftEnd.date|date('H:i') }}
                {% endif %}
            </td>
            <td>{{ trackedTime.pauseDuration|default('00:00') }}</td>
            <td class="working-time">
                {% if trackedTime.totalWorkingTime is not null %}
                    {{ trackedTime.totalWorkingTime }}
                {% else %}
                    -
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<div class="summary-section">
    <h3>Zusammenfassung</h3>
    <table class="summary-table">
        <tr>
            <td><strong>Gesamtarbeitszeit (ohne Pause):</strong></td>
            <td class="summary-value">{{ totals.totalWorkingTime }}</td>
        </tr>
        <tr>
            <td><strong>Gesamtarbeitszeit (mit Pause):</strong></td>
            <td class="summary-value">{{ totals.totalShiftDuration }}</td>
        </tr>
        <tr>
            <td><strong>Gesamtpause:</strong></td>
            <td class="summary-value">{{ totals.totalPause }}</td>
        </tr>
        {% if totals.totalNightShiftWorkingTime != "00:00" %}
            <tr>
                <td><strong>Nachtschichtzuschlag (ohne Pause):</strong></td>
                <td class="summary-value">{{ totals.totalNightShiftWorkingTime }}</td>
            </tr>
        {% endif %}
    </table>
</div>

<div class="signature-section">
    <div class="signature-field">
        <div class="signature-line"></div>
        <div class="signature-label">Unterschrift Mitarbeiter</div>
    </div>
    <div class="signature-field">
        <div class="signature-line"></div>
        <div class="signature-label">Unterschrift Vorgesetzter</div>
    </div>
</div>
</body>
</html>
