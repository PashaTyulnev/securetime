<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zeiterfassung</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            font-size: 12px;
            color: #333;
        }

        .header {
            position: relative;
            margin-bottom: 30px;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .header-left {
            flex: 1;
        }

        .header-right {
            text-align: right;
        }

        .logo {
            max-width: 120px;
            max-height: 60px;
        }

        .header h1 {
            margin: 0 0 10px 0;
            font-size: 18px;
        }

        .company-info {
            margin-bottom: 20px;
            font-size: 11px;
        }

        .summary-top {
            display: flex;
            gap: 30px;
            margin-bottom: 20px;
            padding: 10px;
            background-color: #f5f5f5;
            border: 1px solid #ddd;
        }

        .summary-top-item {
            font-size: 11px;
        }

        .summary-top-item strong {
            display: block;
            margin-bottom: 3px;
            font-size: 10px;
            color: #666;
        }

        .summary-top-item span {
            font-size: 13px;
            font-weight: bold;
            color: #333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
        }

        th, td {
            border: 1px solid #333;
            padding: 8px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background-color: #f0f0f0;
            font-weight: bold;
            text-align: center;
            font-size: 11px;
        }

        td {
            font-size: 11px;
        }

        .working-time {
            font-weight: bold;
        }

        .signature-section {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
        }

        .signature-field {
            width: 45%;
            text-align: center;
        }

        .signature-line {
            border-bottom: 1px solid #333;
            height: 40px;
            margin-bottom: 5px;
        }

        .signature-label {
            font-size: 10px;
            color: #666;
        }

        .summary-section {
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .summary-section h3 {
            margin: 0 0 15px 0;
            font-size: 14px;
            border-bottom: 1px solid #333;
            padding-bottom: 5px;
        }

        .summary-table {
            width: 50%;
            border: none;
            margin-bottom: 0;
        }

        .summary-table td {
            border: none;
            padding: 5px 10px 5px 0;
            border-bottom: 1px dotted #ccc;
        }

        .summary-table td:last-child {
            text-align: right;
            font-weight: bold;
        }

        .summary-value {
            min-width: 80px;
        }

        @media print {
            body {
                margin: 15px;
            }
            .signature-section {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
<div class="header">
    <div class="header-top">
        <div class="header-left">
            <h1>Zeiterfassung</h1>
            <div class="company-info">
                <strong>Zeitraum:</strong> {{ totals.dateFrom|date('d.m.Y') }} - {{ totals.dateTo|date('d.m.Y') }}
            </div>
        </div>
        <div class="header-right">
            <img src="{{ app.request.schemeAndHttpHost ~ '/logo.svg' }}" alt="Logo" class="logo">
        </div>
    </div>

    <div class="summary-top">
        <div class="summary-top-item">
            <strong>Ist-Stunden:</strong>
            <span>{{ totals.totalWorkingTime }} h</span>
        </div>
        <div class="summary-top-item">
            <strong>Soll-Stunden:</strong>
            <span>{{ totals.plannedHours|default('00:00') }} h</span>
        </div>
        <div class="summary-top-item">
            <strong>Differenz:</strong>
            <span>{{ totals.differenceHours|default('+00:00') }} h</span>
        </div>
    </div>
</div>

<table>
    <thead>
    <tr>
        <th>Datum</th>
        <th>Objekt</th>
        <th>Beginn<br>Uhrzeit</th>
        <th>Ende<br>Uhrzeit</th>
        <th>Pause</th>
        <th>Dauer gesamt</th>
    </tr>
    </thead>
    <tbody>
    {% for trackedTime in trackedTimes %}
        <tr>
            <td>{{ trackedTime.shiftStart.date|date('d.m.Y') }}</td>
            <td>{{ trackedTime.facilityName|default('-') }}</td>
            <td>
                {% if trackedTime.shiftStart is not null %}
                    {{ trackedTime.shiftStart.date|date('H:i') }}
                {% endif %}
            </td>
            <td>
                {% if trackedTime.shiftEnd is not null %}
                    {{ trackedTime.shiftEnd.date|date('H:i') }}
                {% endif %}
            </td>
            <td>{{ trackedTime.pauseDuration|default('00:00') }}</td>
            <td class="working-time">
                {% if trackedTime.totalWorkingTime is not null %}
                    {{ trackedTime.totalWorkingTime }}
                {% else %}
                    -
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<div class="summary-section">
    <h3>Zusammenfassung</h3>
    <table class="summary-table">
        <tr>
            <td><strong>Gesamtarbeitszeit (ohne Pause):</strong></td>
            <td class="summary-value">{{ totals.totalWorkingTime }}</td>
        </tr>
        <tr>
            <td><strong>Gesamtarbeitszeit (mit Pause):</strong></td>
            <td class="summary-value">{{ totals.totalShiftDuration }}</td>
        </tr>
        <tr>
            <td><strong>Gesamtpause:</strong></td>
            <td class="summary-value">{{ totals.totalPause }}</td>
        </tr>
        {% if totals.totalNightShiftWorkingTime != "00:00" %}
            <tr>
                <td><strong>Nachtschichtzuschlag (ohne Pause):</strong></td>
                <td class="summary-value">{{ totals.totalNightShiftWorkingTime }}</td>
            </tr>
        {% endif %}
    </table>
</div>

<div class="signature-section">
    <div class="signature-field">
        <div class="signature-line"></div>
        <div class="signature-label">Unterschrift Mitarbeiter</div>
    </div>
    <div class="signature-field">
        <div class="signature-line"></div>
        <div class="signature-label">Unterschrift Vorgesetzter</div>
    </div>
</div>
</body>
</html>
