{% extends 'base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 via-slate-50 to-gray-100 dark:from-gray-950 dark:via-slate-950 dark:to-gray-900">

        {# Header #}
        <header class="sticky top-0 backdrop-blur-2xl bg-white/70 dark:bg-gray-900/70 border-b border-gray-200/50 dark:border-gray-800/50">
            <div class="w-full mx-auto px-6 py-4">
                <div class="flex items-center gap-6">
                    <h1 class="text-3xl font-extralight bg-gradient-to-r from-slate-900 to-slate-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
                        {{ 'dashboard.welcome'|trans }}
                    </h1>
                    <div class="h-8 w-px bg-gray-200 dark:bg-gray-800"></div>
                    <span class="text-sm text-gray-500 dark:text-gray-400 font-light">
                        {{ 'dashboard.shifts_overview_today'|trans }}, {{ "now"|date("d.m.Y") }}
                    </span>
                </div>
            </div>
        </header>

        {# Timetracker #}
        <div class="px-5 pt-5 pb-4 w-full md:w-1/2 lg:w-1/4">
            {% if todayWorkingInformation['workingToday'] %}
                {% if todayWorkingInformation['isCheckedIn'] or todayWorkingInformation['hasPause'] %}
                    {# Zeiterfassungsmodul immer anzeigen wenn eingecheckt oder in Pause #}
                    {% include 'modules/time_tracker.html.twig' %}
                {% elseif todayWorkingInformation['minutesDifferenceToWorkBegin'] > -11 and todayWorkingInformation['minutesDifferenceToWorkBegin'] < 25%}
                    {# Normale Check-in Zeit #}
                    {% include 'modules/time_tracker.html.twig' %}
                {% elseif todayWorkingInformation['minutesDifferenceToWorkBegin'] > 25 %}
                    <div class="bg-red-50 dark:bg-red-900/30 backdrop-blur-xl rounded-2xl border border-red-200 dark:border-red-800 p-6 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            {{ ux_icon('lucide:alert-triangle', { class: 'w-6 h-6 text-red-600 dark:text-red-400' }) }}
                            <h2 class="text-base font-semibold text-red-800 dark:text-red-300">
                                {{ 'dashboard.work_start_missed'|trans }}
                            </h2>
                        </div>

                        <p class="text-sm text-red-700 dark:text-red-300 leading-relaxed">
                            {{ 'dashboard.late_arrival_message'|trans|raw }}
                        </p>
                    </div>
                {% elseif todayWorkingInformation['minutesDifferenceToWorkBegin'] < -10 %}
                    {% set minutesUntilCheckin = (todayWorkingInformation['minutesDifferenceToWorkBegin'] * -1) - 10 %}
                    <div class="bg-amber-50 dark:bg-amber-900/30 backdrop-blur-xl rounded-2xl border border-amber-200 dark:border-amber-800 p-6 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            {{ ux_icon('lucide:clock', { class: 'w-6 h-6 text-amber-600 dark:text-amber-400' }) }}
                            <h2 class="text-base font-semibold text-amber-800 dark:text-amber-300">
                                {{ 'dashboard.too_early'|trans }}
                            </h2>
                        </div>

                        <p class="text-sm text-amber-700 dark:text-amber-300 leading-relaxed">
                            {{ 'dashboard.early_checkin_message'|trans({'%minutes%': minutesUntilCheckin})|raw }}
                        </p>
                    </div>
                {% endif %}
            {% else %}
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-6 shadow-sm">
                    <div class="flex items-center gap-2 mb-2">
                        {{ ux_icon('lucide:info', { class: 'w-5 h-5 text-gray-500 dark:text-gray-400' }) }}
                        <h2 class="text-base font-medium text-gray-900 dark:text-white">{{ 'dashboard.working_status'|trans }}</h2>
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        {{ 'time_tracker.not_planned_today'|trans }}
                    </p>
                </div>
            {% endif %}
        </div>

        {# Shifts Grid #}
        {% if todayShifts|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-5">
                {% for shift in todayShifts %}
                    {% set employee = shift.employee %}
                    {% set demandShift = shift.demandShift %}
                    {% set facility = demandShift.facility %}

                    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-6 shadow-sm hover:shadow-lg transition-all duration-200">

                        <div class="flex items-start justify-between mb-5">
                            <div class="flex items-center gap-4">
                                <div class="w-11 h-11 rounded-full bg-gradient-to-br from-slate-100 to-slate-200 dark:from-gray-700 dark:to-gray-600 flex items-center justify-center">
                                    {{ ux_icon('lucide:user', { class: 'w-5 h-5 text-slate-700 dark:text-gray-300' }) }}
                                </div>
                                <div>
                                    <h3 class="text-base font-medium text-gray-900 dark:text-white leading-tight">
                                        {{ employee.firstName }} {{ employee.lastName }}
                                    </h3>
                                    {% if employee.number %}
                                        <p class="text-xs text-gray-500 dark:text-gray-400">#{{ employee.number }}</p>
                                    {% endif %}
                                </div>
                            </div>
                            {% if shift.isOnCall %}
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-blue-100/70 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
                                    {{ 'dashboard.on_call'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        <div class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">
                            {% if facility %}
                                <div class="flex items-center gap-2">
                                    {{ ux_icon('lucide:building-2', { class: 'w-4 h-4 opacity-70' }) }}
                                    <span>{{ facility.title }}</span>
                                </div>
                            {% endif %}

                            {% if demandShift.timeFrom and demandShift.timeTo %}
                                <div class="flex items-center gap-2">
                                    {{ ux_icon('lucide:clock', { class: 'w-4 h-4 opacity-70' }) }}
                                    <span>{{ demandShift.timeFrom|date('H:i') }} – {{ demandShift.timeTo|date('H:i') }} {{ 'dashboard.time_suffix'|trans }}</span>
                                </div>
                            {% endif %}

                            {% if demandShift.name %}
                                <div class="flex items-center gap-2">
                                    {{ ux_icon('lucide:briefcase', { class: 'w-4 h-4 opacity-70' }) }}
                                    <span>{{ demandShift.name }}</span>
                                </div>
                            {% endif %}

                            {% if shift.note %}
                                <div class="pt-3 mt-3 border-t border-gray-200/60 dark:border-gray-700/60">
                                    <p class="italic text-gray-500 dark:text-gray-400 text-sm">{{ shift.note }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-white/80 dark:bg-gray-800/80 m-5 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-12 text-center">
                <div class="mx-auto w-16 h-16 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-700 mb-4">
                    {{ ux_icon('lucide:calendar-x', { class: 'w-8 h-8 text-gray-400 dark:text-gray-500' }) }}
                </div>
                <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">{{ 'dashboard.no_shifts_today'|trans }}</h3>
                <p class="text-gray-600 dark:text-gray-400">{{ 'dashboard.no_shifts_today_description'|trans }}</p>
            </div>
        {% endif %}

    </div>
{% endblock %}
