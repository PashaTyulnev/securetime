{% extends 'base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 via-slate-50 to-gray-100 dark:from-gray-950 dark:via-slate-950 dark:to-gray-900">

        {% include 'dashboard/_header.html.twig' %}

        {% include 'dashboard/_working_status.html.twig' with { todayWorkingInformation: todayWorkingInformation } %}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 px-5 pt-2 pb-8">
            {% include 'dashboard/_today_shifts.html.twig' with { upcomingUserShifts: upcomingUserShifts ?? [] } %}
            {% include 'dashboard/_upcoming_shifts.html.twig' with { upcomingUserShifts: upcomingUserShifts ?? [] } %}
        </div>

    </div>
{% endblock %}
