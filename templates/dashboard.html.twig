{% extends 'base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 via-slate-50 to-gray-100 dark:from-gray-950 dark:via-slate-950 dark:to-gray-900">

        {# Header #}
        <header class="sticky top-0 backdrop-blur-2xl bg-white/70 dark:bg-gray-900/70 border-b border-gray-200/50 dark:border-gray-800/50">
            <div class="w-full mx-auto px-6 py-4">
                <div class="flex items-center gap-6">
                    <h1 class="text-3xl font-extralight bg-gradient-to-r from-slate-900 to-slate-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
                        {{ 'dashboard.welcome'|trans }}
                    </h1>
                    <div class="h-8 w-px bg-gray-200 dark:bg-gray-800"></div>
                    <span class="text-sm text-gray-500 dark:text-gray-400 font-light">
                        {{ 'dashboard.shifts_overview_today'|trans }}, {{ "now"|date("d.m.Y") }}
                    </span>
                </div>
            </div>
        </header>

        {# Timetracker #}
        <div class="px-5 pt-5 pb-4 w-full md:w-1/2 lg:w-1/4">
            {% if todayWorkingInformation['workingToday'] %}
                {% if todayWorkingInformation['isCheckedIn'] or todayWorkingInformation['hasPause'] %}
                    {# Zeiterfassungsmodul immer anzeigen wenn eingecheckt oder in Pause #}
                    {% include 'modules/time_tracker.html.twig' %}
                {% elseif todayWorkingInformation['minutesDifferenceToWorkBegin'] is not null and todayWorkingInformation['minutesDifferenceToWorkBegin'] > -11 and todayWorkingInformation['minutesDifferenceToWorkBegin'] < 25 %}
                    {# Check-in-Fenster für nächste Schicht heute (z. B. zweite Schicht nach erstem Check-out) #}
                    {% include 'modules/time_tracker.html.twig' %}
                {% elseif todayWorkingInformation['hasCheckedOutToday'] %}
                    {# Benutzer hat heute ausgecheckt, keine weitere Schicht heute im Fenster #}
                    {% if todayWorkingInformation['earlyCheckoutToday'] %}
                        <div class="bg-amber-50 dark:bg-amber-900/30 backdrop-blur-xl rounded-2xl border border-amber-200 dark:border-amber-800 p-6 shadow-sm mb-4">
                            <div class="flex items-center gap-3 mb-2">
                                {{ ux_icon('lucide:log-out', { class: 'w-6 h-6 text-amber-600 dark:text-amber-400' }) }}
                                <h2 class="text-base font-semibold text-amber-800 dark:text-amber-300">
                                    {{ 'dashboard.early_checkout_title'|trans }}
                                </h2>
                            </div>
                            <p class="text-sm text-amber-700 dark:text-amber-300 leading-relaxed">
                                {{ 'dashboard.early_checkout_message'|trans }}
                            </p>
                        </div>
                    {% endif %}
                    {% if todayWorkingInformation['nextPlannedShift'] %}
                        {# Zeige nächste geplante Schicht #}
                        {% set nextShift = todayWorkingInformation['nextPlannedShift'] %}
                        <div class="bg-green-50 dark:bg-green-900/30 backdrop-blur-xl rounded-2xl border border-green-200 dark:border-green-800 p-6 shadow-sm">
                            <div class="flex items-center gap-3 mb-3">
                                {{ ux_icon('lucide:check-circle', { class: 'w-6 h-6 text-green-600 dark:text-green-400' }) }}
                                <h2 class="text-base font-semibold text-green-800 dark:text-green-300">
                                    {{ 'dashboard.shift_completed'|trans }}
                                </h2>
                            </div>

                            <p class="text-sm text-green-700 dark:text-green-300 leading-relaxed mb-4">
                                {{ 'dashboard.next_shift_info'|trans|raw }}
                            </p>

                            <div class="space-y-2 text-sm">
                                {% if nextShift['facility'] %}
                                    <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                                        {{ ux_icon('lucide:building-2', { class: 'w-4 h-4 opacity-70' }) }}
                                        <span>{{ nextShift['facility'].title }}</span>
                                    </div>
                                {% endif %}

                                <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                                    {{ ux_icon('lucide:calendar', { class: 'w-4 h-4 opacity-70' }) }}
                                    <span>
                                        {{ nextShift['dateTime']|date('d.m.Y') }},
                                        {{ nextShift['timeFrom']|date('H:i') }} – {{ nextShift['timeTo']|date('H:i') }} {{ 'dashboard.time_suffix'|trans }}
                                    </span>
                                </div>

                                {% if nextShift['name'] %}
                                    <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                                        {{ ux_icon('lucide:briefcase', { class: 'w-4 h-4 opacity-70' }) }}
                                        <span>{{ nextShift['name'] }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        {# Keine nächste Schicht gefunden #}
                        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-6 shadow-sm">
                            <div class="flex items-center gap-3 mb-3">
                                {{ ux_icon('lucide:check-circle', { class: 'w-6 h-6 text-green-600 dark:text-green-400' }) }}
                                <h2 class="text-base font-semibold text-gray-900 dark:text-white">
                                    {{ 'dashboard.shift_completed'|trans }}
                                </h2>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-300">
                                {{ 'dashboard.no_next_shift'|trans }}
                            </p>
                        </div>
                    {% endif %}
                {% elseif todayWorkingInformation['minutesDifferenceToWorkBegin'] is not null and todayWorkingInformation['minutesDifferenceToWorkBegin'] > 25 %}
                    {# Nur anzeigen wenn nicht bereits heute ausgecheckt #}
                    {% if not todayWorkingInformation['hasCheckedOutToday'] %}
                        <div class="bg-red-50 dark:bg-red-900/30 backdrop-blur-xl rounded-2xl border border-red-200 dark:border-red-800 p-6 shadow-sm">
                            <div class="flex items-center justify-center gap-3 mb-3 relative">
                                <h2 class="text-base font-semibold text-red-800 dark:text-red-300 text-center">
                                    {{ 'dashboard.work_start_missed'|trans }}!!!
                                </h2>
                                <div class="absolute right-0">
                                    {{ ux_icon('lucide:alert-triangle', { class: 'w-6 h-6 text-red-600 dark:text-red-400' }) }}
                                </div>
                            </div>

                            <p class="text-sm text-red-700 dark:text-red-300 leading-relaxed text-center">
                                {{ 'dashboard.late_arrival_message'|trans|raw }}
                            </p>
                        </div>
                    {% endif %}
                {% elseif todayWorkingInformation['minutesDifferenceToWorkBegin'] is not null and todayWorkingInformation['minutesDifferenceToWorkBegin'] < -10 %}
                    {% set minutesUntilCheckin = (todayWorkingInformation['minutesDifferenceToWorkBegin'] * -1) - 10 %}
                    <div class="bg-amber-50 dark:bg-amber-900/30 backdrop-blur-xl rounded-2xl border border-amber-200 dark:border-amber-800 p-6 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            {{ ux_icon('lucide:clock', { class: 'w-6 h-6 text-amber-600 dark:text-amber-400' }) }}
                            <h2 class="text-base font-semibold text-amber-800 dark:text-amber-300">
                                {{ 'dashboard.too_early'|trans }}
                            </h2>
                        </div>

                        <p class="text-sm text-amber-700 dark:text-amber-300 leading-relaxed">
                            {{ 'dashboard.early_checkin_message'|trans({'%minutes%': minutesUntilCheckin})|raw }}
                        </p>
                    </div>
                {% endif %}
            {% else %}

                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-6 shadow-sm">
                    <div class="flex items-center gap-2 mb-2">
                        {{ ux_icon('lucide:info', { class: 'w-5 h-5 text-gray-500 dark:text-gray-400' }) }}
                        <h2 class="text-base font-medium text-gray-900 dark:text-white">{{ 'dashboard.working_status'|trans }}</h2>
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        {{ 'time_tracker.not_planned_today'|trans }}
                    </p>
                </div>
            {% endif %}
        </div>

        {# Kommende Schichten des Benutzers (nächste 7 Tage) #}
        <div class="px-5 pb-8">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-5 md:p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        {{ ux_icon('lucide:calendar-days', { class: 'w-5 h-5 text-slate-700 dark:text-gray-200' }) }}
                        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">
                            {{ 'dashboard.my_upcoming_shifts'|trans }}
                        </h2>
                    </div>
                    <span class="text-[11px] px-2 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">
                        7 Tage
                    </span>
                </div>

                {% if upcomingUserShifts is defined and upcomingUserShifts|length > 0 %}
                    <div class="space-y-3">
                        {% for shift in upcomingUserShifts %}
                            {% set demandShift = shift.demandShift %}
                            {% set facility = demandShift.facility %}
                            {% set shiftDate = shift.date %}
                            {% set isToday = shiftDate|date('Y-m-d') == 'now'|date('Y-m-d') %}

                            {% if not isToday %}
                                {# Heutige Schicht wird oben bereits angezeigt #}
                                {% set isTomorrow = shiftDate|date('Y-m-d') == ('tomorrow'|date('Y-m-d')) %}

                                <div class="flex items-start gap-3 p-3 rounded-2xl border border-gray-200/70 dark:border-gray-700/70 bg-gray-50/60 dark:bg-gray-900/40">
                                    <div class="flex flex-col items-center w-14 text-xs text-gray-500 dark:text-gray-400">
                                        <span class="font-semibold text-gray-900 dark:text-white">
                                            {% if isTomorrow %}
                                                {{ 'schedule.tomorrow'|trans|default('Morgen') }}
                                            {% else %}
                                                {{ shiftDate|date('d.m.') }}
                                            {% endif %}
                                        </span>
                                        {% if demandShift.timeFrom and demandShift.timeTo %}
                                            <span class="mt-1">
                                                {{ demandShift.timeFrom|date('H:i') }}<br/>
                                                {{ demandShift.timeTo|date('H:i') }}
                                            </span>
                                        {% endif %}
                                    </div>

                                    <div class="flex-1 space-y-1.5">
                                        {% if facility %}
                                            <div class="inline-flex items-center px-3 py-1 rounded-full bg-slate-900 text-white text-[11px] font-semibold dark:bg-slate-100 dark:text-slate-900">
                                                {{ ux_icon('lucide:building-2', { class: 'w-3.5 h-3.5 mr-1.5' }) }}
                                                <span class="truncate max-w-[180px] sm:max-w-xs">{{ facility.title }}</span>
                                            </div>
                                        {% endif %}

                                        {% if demandShift.name %}
                                            <div class="text-xs text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                                                {{ ux_icon('lucide:briefcase', { class: 'w-3.5 h-3.5 opacity-70' }) }}
                                                <span class="truncate">{{ demandShift.name }}</span>
                                            </div>
                                        {% endif %}

                                        {% if shift.isOnCall %}
                                            <span class="inline-flex items-center mt-1 px-2 py-0.5 text-[10px] font-medium rounded-full bg-blue-100/70 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">
                                                {{ 'dashboard.on_call'|trans }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-xs text-gray-600 dark:text-gray-400">
                        {{ 'dashboard.no_upcoming_shifts_7_days'|trans }}
                    </p>
                {% endif %}
            </div>
        </div>

    </div>
{% endblock %}
