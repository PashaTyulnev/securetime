{# Kommende Schichten (nächste 7 Tage). Erwartet: upcomingUserShifts #}
<div class="px-5 pb-8">
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-5 md:p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
                {{ ux_icon('lucide:calendar-days', { class: 'w-5 h-5 text-slate-700 dark:text-gray-200' }) }}
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">
                    {{ 'dashboard.my_upcoming_shifts'|trans }}
                </h2>
            </div>
            <span class="text-[11px] px-2 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">
                7 Tage
            </span>
        </div>

        {% if upcomingUserShifts is defined and upcomingUserShifts|length > 0 %}
            <div class="space-y-3">
                {% for shift in upcomingUserShifts %}
                    {% set demandShift = shift.demandShift %}
                    {% set facility = demandShift.facility %}
                    {% set shiftDate = shift.date %}
                    {% set isToday = shiftDate|date('Y-m-d') == 'now'|date('Y-m-d') %}

                    {% if not isToday %}
                        {% set isTomorrow = shiftDate|date('Y-m-d') == ('tomorrow'|date('Y-m-d')) %}

                        <div class="flex items-start gap-3 p-3 rounded-2xl border border-gray-200/70 dark:border-gray-700/70 bg-gray-50/60 dark:bg-gray-900/40">
                            <div class="flex flex-col items-center w-14 text-xs text-gray-500 dark:text-gray-400">
                                <span class="font-semibold text-gray-900 dark:text-white">
                                    {% if isTomorrow %}
                                        {{ 'schedule.tomorrow'|trans|default('Morgen') }}
                                    {% else %}
                                        {{ shiftDate|date('d.m.') }}
                                    {% endif %}
                                </span>
                                {% if demandShift.timeFrom and demandShift.timeTo %}
                                    <span class="mt-1">
                                        {{ demandShift.timeFrom|date('H:i') }}<br/>
                                        {{ demandShift.timeTo|date('H:i') }}
                                    </span>
                                {% endif %}
                            </div>

                            <div class="flex-1 space-y-1.5">
                                {% if facility %}
                                    <div class="inline-flex items-center px-3 py-1 rounded-full bg-slate-900 text-white text-[11px] font-semibold dark:bg-slate-100 dark:text-slate-900">
                                        {{ ux_icon('lucide:building-2', { class: 'w-3.5 h-3.5 mr-1.5' }) }}
                                        <span class="truncate max-w-[180px] sm:max-w-xs">{{ facility.title }}</span>
                                    </div>
                                {% endif %}

                                {% if demandShift.name %}
                                    <div class="text-xs text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                                        {{ ux_icon('lucide:briefcase', { class: 'w-3.5 h-3.5 opacity-70' }) }}
                                        <span class="truncate">{{ demandShift.name }}</span>
                                    </div>
                                {% endif %}

                                {% if shift.isOnCall %}
                                    <span class="inline-flex items-center mt-1 px-2 py-0.5 text-[10px] font-medium rounded-full bg-blue-100/70 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">
                                        {{ 'dashboard.on_call'|trans }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% else %}
            <p class="text-xs text-gray-600 dark:text-gray-400">
                {{ 'dashboard.no_upcoming_shifts_7_days'|trans }}
            </p>
        {% endif %}
    </div>
</div>
