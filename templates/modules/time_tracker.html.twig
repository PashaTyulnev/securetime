<div data-controller="timetracker--process"
     data-timetracker--process-error-checkin-value="{{ 'time_tracker.error_checkin'|trans|e('html_attr') }}"
     data-timetracker--process-error-checkout-value="{{ 'time_tracker.error_checkout'|trans|e('html_attr') }}"
     data-timetracker--process-error-pause-value="{{ 'time_tracker.error_pause'|trans|e('html_attr') }}"
     data-timetracker--process-success-checkin-value="{{ 'time_tracker.checkin_success'|trans|e('html_attr') }}"
     data-timetracker--process-success-checkout-value="{{ 'time_tracker.checkout_success'|trans|e('html_attr') }}"
     data-timetracker--process-success-pause-value="{{ 'time_tracker.pause_started'|trans|e('html_attr') }}"
     data-timetracker--process-working-since-value="{{ 'time_tracker.working_since'|trans|e('html_attr') }}"
     data-timetracker--process-pause-since-value="{{ 'time_tracker.pause_since'|trans|e('html_attr') }}"
     data-timetracker--process-checked-out-at-value="{{ 'time_tracker.checked_out_at'|trans|e('html_attr') }}">
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl border border-gray-200/60 dark:border-gray-700/60 p-6 shadow-sm">

        <div class="flex items-center gap-2 mb-4">
            {{ ux_icon('lucide:clock', { class: 'w-5 h-5 text-gray-500 dark:text-gray-400' }) }}
            <h2 class="text-base font-medium text-gray-900 dark:text-white">{{ 'time_tracker.checkin'|trans }}</h2>
        </div>

        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4 min-h-[20px]"
           data-timetracker--process-target="workingSince"></p>

        <div class="space-y-2">
            <button type="button"
                    class="w-full px-4 py-2.5 rounded-xl bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white text-sm font-medium transition-all duration-200 shadow-sm flex items-center justify-center gap-2"
                    data-action="click->timetracker--process#checkin"
                    data-timetracker--process-target="checkinButton">
                {{ ux_icon('lucide:log-in', { class: 'w-4 h-4' }) }}
                <span>{{ 'time_tracker.checkin'|trans }}</span>
            </button>

            <button type="button"
                    class="hidden w-full px-4 py-2.5 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white text-sm font-medium transition-all duration-200 shadow-sm flex items-center justify-center gap-2"
                    data-action="click->timetracker--process#checkout"
                    data-timetracker--process-target="checkoutButton">
                {{ ux_icon('lucide:log-out', { class: 'w-4 h-4' }) }}
                <span>{{ 'time_tracker.checkout'|trans }}</span>
            </button>

            <button type="button"
                    class="hidden w-full px-4 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white text-sm font-medium transition-all duration-200 shadow-sm flex items-center justify-center gap-2"
                    data-action="click->timetracker--process#pausein"
                    data-timetracker--process-target="pauseinButton">
                {{ ux_icon('lucide:pause-circle', { class: 'w-4 h-4' }) }}
                <span>{{ 'common.pause'|trans }}</span>
            </button>
        </div>
    </div>
</div>
