<div data-controller="modal"
     data-modal-target="modal"
     data-modal-no-autoshow
     tabindex="-1"
     aria-hidden="true"
     class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-100 hidden">
    <div class="h-full w-full overflow-y-auto flex items-center justify-center min-h-full p-4 sm:p-6 lg:p-8">
        <div
            class="relative w-full max-w-5xl bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-gray-200/50 dark:border-gray-700/50 transform transition-all animate-modal-enter my-8">
            {# Close Button #}
            <button data-action="click->modal#hide"
                    class="absolute top-6 right-6 z-10 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-all duration-200 p-2 hover:bg-gray-100/50 dark:hover:bg-gray-800/50 rounded-xl">
                {{ ux_icon('lucide:x', { class: 'h-5 w-5' }) }}
            </button>

            {# Scrollbarer Content-Bereich #}
            <div class="max-h-[calc(100vh-8rem)] overflow-y-auto rounded-3xl">
                <div class="p-8">
                    <div class="flex items-center gap-3 mb-6">
                        {{ ux_icon('lucide:clock', { class: 'w-6 h-6 text-slate-600 dark:text-slate-400' }) }}
                        <h2 class="text-2xl font-light text-gray-900 dark:text-white">
                            {{ 'time_tracker.create_manual_entry'|trans|default('Zeiteintrag erstellen') }}
                        </h2>
                    </div>

                    <form data-action="submit->timetracker--admin#createManualTimeEntry">
                        <div class="space-y-5">
                            {# Mitarbeiter Dropdown #}
                            <div>
                                <label for="employeeSelect" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                    {{ 'navigation.employees'|trans }}
                                </label>
                                <select id="employeeSelect"
                                        name="employeeId"
                                        required
                                        data-timetracker--admin-target="employeeSelect"
                                        class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-slate-500/50 dark:focus:ring-slate-400/50 transition-all">
                                    <option value="">{{ 'common.select'|trans|default('Bitte auswählen') }}</option>
                                </select>
                            </div>

                            {# Datum #}
                            <div>
                                <label for="entryDate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                    {{ 'common.date'|trans|default('Datum') }}
                                </label>
                                <input type="date"
                                       id="entryDate"
                                       name="date"
                                       required
                                       data-timetracker--admin-target="entryDate"
                                       class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-slate-500/50 dark:focus:ring-slate-400/50 transition-all">
                            </div>

                            {# Zeit von #}
                            <div>
                                <label for="timeFrom" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                    {{ 'common.start'|trans }} {{ 'common.time'|trans|default('Zeit') }}
                                </label>
                                <input type="time"
                                       id="timeFrom"
                                       name="timeFrom"
                                       required
                                       data-timetracker--admin-target="timeFrom"
                                       class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-slate-500/50 dark:focus:ring-slate-400/50 transition-all">
                            </div>

                            {# Zeit bis (optional – nur bei Angabe wird Check-out erstellt) #}
                            <div>
                                <label for="timeTo" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                    {{ 'common.end'|trans }} {{ 'common.time'|trans|default('Zeit') }}
                                    <span class="text-gray-500 dark:text-gray-400 font-normal">({{ 'common.optional'|trans|default('optional') }})</span>
                                </label>
                                <input type="time"
                                       id="timeTo"
                                       name="timeTo"
                                       data-timetracker--admin-target="timeTo"
                                       class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-slate-500/50 dark:focus:ring-slate-400/50 transition-all"
                                       placeholder="">
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{ 'time_tracker.manual_entry_end_optional'|trans|default('Leer lassen = nur Check-in erstellen') }}</p>
                            </div>
                        </div>

                        {# Buttons #}
                        <div class="flex items-center justify-end gap-3 mt-8 pt-6 border-t border-gray-200/50 dark:border-gray-700/50">
                            <button type="button"
                                    data-action="click->modal#hide"
                                    class="px-6 py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors font-medium">
                                {{ 'common.cancel'|trans|default('Abbrechen') }}
                            </button>
                            <button type="submit"
                                    class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-slate-600 to-slate-700 hover:from-slate-700 hover:to-slate-800 text-white font-medium transition-all shadow-sm">
                                {{ 'common.create'|trans|default('Erstellen') }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            {# Bottom Decoration #}
            <div
                class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-slate-200 dark:via-gray-700 to-transparent rounded-b-3xl"></div>
        </div>
    </div>
</div>
