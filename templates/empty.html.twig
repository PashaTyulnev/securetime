{% extends 'base.html.twig' %}
{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 via-slate-50 to-gray-100 dark:from-gray-950 dark:via-slate-950 dark:to-gray-900">
        <header class="sticky top-0 backdrop-blur-2xl bg-white/70 dark:bg-gray-900/70 border-b border-gray-200/50 dark:border-gray-800/50">
            <div class="w-full mx-auto px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-6">
                        <h1 class="text-3xl font-extralight bg-gradient-to-r from-slate-900 to-slate-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
                            Willkommen
                        </h1>
                        <div class="h-8 w-px bg-gray-200 dark:bg-gray-800"></div>
                        <span class="text-sm text-gray-500 dark:text-gray-400 font-light"> Übersicht der Schichten für heute, {{ "now"|date("d.m.Y") }}</span>
                    </div>

                </div>
            </div>
        </header>


        {% if todayShifts|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-5">

                {% for shift in todayShifts %}
                    {% set employee = shift.employee %}
                    {% set demandShift = shift.demandShift %}
                    {% set facility = demandShift.facility %}

                    <div class="bg-white/80 dark:bg-gray-800/80
                    backdrop-blur-xl
                    rounded-2xl
                    border border-gray-200/60 dark:border-gray-700/60
                    p-6
                    shadow-sm hover:shadow-lg
                    transition-all duration-200">

                        <div class="flex items-start justify-between mb-5">
                            <div class="flex items-center gap-4">
                                <div class="w-11 h-11 rounded-full
                                bg-gradient-to-br from-slate-100 to-slate-200
                                dark:from-gray-700 dark:to-gray-600
                                flex items-center justify-center">
                                    {{ ux_icon('lucide:user', { class: 'w-5 h-5 text-slate-700 dark:text-gray-300' }) }}
                                </div>

                                <div>
                                    <h3 class="text-base font-medium text-gray-900 dark:text-white leading-tight">
                                        {{ employee.firstName }} {{ employee.lastName }}
                                    </h3>
                                    {% if employee.number %}
                                        <p class="text-xs text-gray-500 dark:text-gray-400">
                                            #{{ employee.number }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>

                            {% if shift.isOnCall %}
                                <span class="px-2.5 py-1 text-xs font-medium
                                 rounded-full
                                 bg-blue-100/70 dark:bg-blue-900/30
                                 text-blue-700 dark:text-blue-300">
                        Bereitschaft
                    </span>
                            {% endif %}
                        </div>

                        <div class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">

                            {% if facility %}
                                <div class="flex items-center gap-2">
                                    {{ ux_icon('lucide:building-2', { class: 'w-4 h-4 opacity-70' }) }}
                                    <span>{{ facility.title }}</span>
                                </div>
                            {% endif %}

                            {% if demandShift.timeFrom and demandShift.timeTo %}
                                <div class="flex items-center gap-2">
                                    {{ ux_icon('lucide:clock', { class: 'w-4 h-4 opacity-70' }) }}
                                    <span>
                            {{ demandShift.timeFrom|date('H:i') }} – {{ demandShift.timeTo|date('H:i') }} Uhr
                        </span>
                                </div>
                            {% endif %}

                            {% if demandShift.name %}
                                <div class="flex items-center gap-2">
                                    {{ ux_icon('lucide:briefcase', { class: 'w-4 h-4 opacity-70' }) }}
                                    <span>{{ demandShift.name }}</span>
                                </div>
                            {% endif %}

                            {% if shift.note %}
                                <div class="pt-3 mt-3 border-t border-gray-200/60 dark:border-gray-700/60">
                                    <p class="italic text-gray-500 dark:text-gray-400 text-sm">
                                        {{ shift.note }}
                                    </p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}

            </div>
        {% else %}

            <div class="bg-white/80 dark:bg-gray-800/80 m-5
            backdrop-blur-xl
            rounded-2xl
            border border-gray-200/60 dark:border-gray-700/60
            p-12 text-center">

                <div class="mx-auto w-16 h-16 flex items-center justify-center
                rounded-full bg-gray-100 dark:bg-gray-700 mb-4">
                    {{ ux_icon('lucide:calendar-x', { class: 'w-8 h-8 text-gray-400 dark:text-gray-500' }) }}
                </div>

                <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">
                    Keine Schichten heute
                </h3>
                <p class="text-gray-600 dark:text-gray-400">
                    Für heute sind keine Schichten eingetragen.
                </p>
            </div>

        {% endif %}

</div>
{% endblock %}
