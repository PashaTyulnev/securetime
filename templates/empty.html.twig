{% extends 'base.html.twig' %}
{% block body %}
<div class="p-8">
    <div class="mb-8">
        <h1 class="text-3xl font-light text-gray-900 dark:text-white tracking-tight mb-2">
            Willkommen
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
            Übersicht der Schichten für heute, {{ "now"|date("d.m.Y") }}
        </p>
    </div>

    {% if todayShifts|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for shift in todayShifts %}
                {% set employee = shift.employee %}
                {% set demandShift = shift.demandShift %}
                {% set facility = demandShift.facility %}

                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-12 h-12 bg-gradient-to-br from-slate-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 rounded-full flex items-center justify-center">
                                {{ ux_icon('lucide:user', { class: 'w-6 h-6 text-slate-700 dark:text-gray-300' }) }}
                            </div>
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                                    {{ employee.firstName }} {{ employee.lastName }}
                                </h3>
                                {% if employee.number %}
                                    <p class="text-sm text-gray-500 dark:text-gray-400">
                                        #{{ employee.number }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                        {% if shift.isOnCall %}
                            <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 rounded-full">
                                Bereitschaft
                            </span>
                        {% endif %}
                    </div>

                    <div class="space-y-2">
                        {% if facility %}
                            <div class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
                                {{ ux_icon('lucide:building-2', { class: 'w-4 h-4' }) }}
                                <span>{{ facility.title }}</span>
                            </div>
                        {% endif %}

                        {% if demandShift.timeFrom and demandShift.timeTo %}
                            <div class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
                                {{ ux_icon('lucide:clock', { class: 'w-4 h-4' }) }}
                                <span>
                                    {{ demandShift.timeFrom|date('H:i') }} - {{ demandShift.timeTo|date('H:i') }} Uhr
                                </span>
                            </div>
                        {% endif %}

                        {% if demandShift.name %}
                            <div class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
                                {{ ux_icon('lucide:briefcase', { class: 'w-4 h-4' }) }}
                                <span>{{ demandShift.name }}</span>
                            </div>
                        {% endif %}

                        {% if shift.note %}
                            <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                                <p class="text-sm text-gray-600 dark:text-gray-400 italic">
                                    {{ shift.note }}
                                </p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-12 text-center">
            <div class="mx-auto w-20 h-20 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-700 mb-4">
                {{ ux_icon('lucide:calendar-x', { class: 'w-10 h-10 text-gray-400 dark:text-gray-500' }) }}
            </div>
            <h3 class="text-xl font-medium text-gray-900 dark:text-white mb-2">
                Keine Schichten heute
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
                Für heute sind keine Schichten eingetragen.
            </p>
        </div>
    {% endif %}
</div>
{% endblock %}
